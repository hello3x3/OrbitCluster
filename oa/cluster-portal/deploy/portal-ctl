#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
portal-ctl —— 集群门户特权助手（root 执行，被 web 服务通过 sudoers 白名单调用）

所有命令的输出统一为 JSON（stdout），字段含 ok=True/False。本脚本只做
"经过严格校验的有限动作"，绝不 eval/拼接任意 shell。web 服务（portal 用户）
仅能通过 sudo 调用本脚本，无法直接以 root 跑其它命令。

命令一览（见 main()）:
  ping                健康自检
  sinfo               节点状态(含 IP / 内存 / gres / 分区)
  provision-user <u> <quota> [--skip-os]   开通集群账号(admin+计算节点)或仅初始化
  unprovision-user <u>                     注销集群账号(危险，仅测试/清理用)
  init-user <u>                            仅初始化已有 OS 用户的 .ssh/.portal 目录
  ensure-assoc <u>                         确保该用户在会计里有账户关联(幂等；缺关联会
                                           导致 sbatch 报 Invalid account...)
  user-status <u>                          查看账号在 admin/各节点的状态
  submit               读取 stdin JSON, 以该用户身份 sbatch 提交容器交互作业
  kill <u> <jobid>                         停机(校验属主后 scancel)
  job-state <u> <jobid>                    查单个作业状态(squeue→sacct 回退)
  log <u> <jobid> [lines]                  读取作业输出日志尾部
  rm-log <u> <jobid>                      删除某作业日志文件(清理已删除实例残留)
  save-image <u> <jobid> <name> [force]   把运行中容器的当前状态保存为个人镜像
                                          (/share/images/<u>/<name>.sqsh, 计入用户配额)
  images <u>                              列出 /share/images/<u> 下该用户个人镜像
  get-keys <u> / set-keys <u>              读写 authorized_keys
  quota <u>                                读取 /share 磁盘配额(实际 OS 值)
  quota-all                                批量读取 /share 全部用户配额
  set-quota <u> <大小>                     设置 /share 配额(实际 OS 值, 软=硬)
  slurm-info <u>                           读取 slurm 关联/QoS/优先级/限额(经 sacctmgr)
"""
import json
import os
import re
import subprocess
import sys

USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
QUOTA_RE = re.compile(r"^[1-9][0-9]{0,2}[GgTtMm]$")
HOURS_RE = re.compile(r"^\d{1,3}:\d{2}:\d{2}$")
IMG_NAME_RE = re.compile(r"^[A-Za-z0-9_]{1,64}$")
PUBKEY_RE = re.compile(
    r"^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp(256|384|521)|"
    r"sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) "
    r"[A-Za-z0-9+/]{20,}={0,2}( [^\r\n]{0,200})?$"
)
RESERVED = {"root", "portal", "slurm", "nobody", "daemon", "bin", "sys", "games",
            "man", "lp", "mail", "news", "uucp", "proxy", "www-data", "backup",
            "list", "irc", "_apt", "nobody", "systemd-*"}
CLUSTER_ADMIN_DIR = "/opt/cluster-admin"
SHARE_HOME = "/share/home"

# ----------------------------------------------------------------------------
# 站点配置（与 portalapp/siteconf.py 读同一个文件，保持两端行为一致）
#   /etc/cluster-portal/site.conf  每行 KEY=VALUE，# 起注释
#   本站点认的键：SSH_PORT <其它键由门户进程使用>
# 节点名不在这里配置：一律经 sinfo 运行时探测，节点 IP 从 /etc/hosts 解析。
# ----------------------------------------------------------------------------
SITE_CONF = os.environ.get("PORTAL_SITE_CONF", "/etc/cluster-portal/site.conf")


def _load_site_conf(path):
    cfg = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for raw in fh:
                ln = raw.split("#", 1)[0].strip()
                if not ln or "=" not in ln:
                    continue
                k, v = ln.split("=", 1)
                k = k.strip().upper()
                if k:
                    cfg[k] = v.strip()
    except OSError:
        pass
    return cfg


SITE = _load_site_conf(SITE_CONF)
# 节点间 ssh 端口：环境变量 > 站点配置 > 默认 2180
SSH_PORT = str(os.environ.get("PORTAL_SSH_PORT") or SITE.get("SSH_PORT") or "2180")


def user_home(username):
    """真实 OS 家目录（root 的 /root 等也能正确解析），失败回退 /share/home/<user>。"""
    r = run(["getent", "passwd", username], timeout=20)
    parts = r.stdout.split(":")
    if r.returncode == 0 and len(parts) >= 7 and parts[0] == username and parts[5]:
        return parts[5]
    return os.path.join(SHARE_HOME, username)
CTL = "portal-ctl"


def out(obj, code=0):
    try:
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    except BrokenPipeError:
        pass
    sys.exit(code)


def die(msg):
    out({"ok": False, "error": str(msg)}, code=1)


def run(argv, timeout=120, input_text=None, env=None, **kw):
    """run a command, return CompletedProcess (never raises on rc)."""
    full_env = dict(os.environ)
    full_env["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    if env:
        full_env.update(env)
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout,
                              input=input_text, env=full_env, **kw)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", "timeout after %ss" % timeout)


def run_ok(argv, timeout=120, input_text=None):
    r = run(argv, timeout=timeout, input_text=input_text)
    return r.returncode == 0


def sh_out(argv, timeout=120):
    r = run(argv, timeout=timeout)
    return r.stdout.strip() if r.returncode == 0 else ""


def valid_user(u):
    return bool(USER_RE.match(u or "")) and u not in RESERVED


def name_ok(u):
    """仅格式校验（不排除 root 等真实 OS 账号；root 不能被建号/注销，另有保留名单保护）。"""
    return bool(USER_RE.match(u or ""))


def reserved_guard(u):
    """建号/注销类命令的保护：保留用户名（root/portal 等）一律拒绝。"""
    return u in RESERVED


def node_hostname():
    return sh_out(["hostname", "-s"])


def compute_nodes():
    """admin 上可用的计算节点名（含 admin 自身），按 sinfo 分区实际输出。"""
    out_txt = sh_out(["sinfo", "-h", "-N", "-o", "%N"], timeout=30)
    return [x for x in out_txt.split() if x] or ["admin"]


def partition_name():
    p = sh_out(["sinfo", "-h", "-o", "%P"], timeout=30)
    return (p.split()[0] if p else "gpu").rstrip("*")


def nodes_ips(names=None):
    """节点名 -> IP（通用实现，不依赖固定节点名单）。

    以 /etc/hosts 为准：同一名字出现多次时**非回环地址优先、取最后一条**
    （与本手册"127.0.1.1 本机名 在前、真实 IP 在后"的写法一致）；
    回环地址仅在确实没有真实地址时采用。文件里没有的节点用 getent 兜底。
    因此加节点 / 改节点名都不需要改代码。
    """
    wanted = set(names) if names else None
    seen = {}
    try:
        with open("/etc/hosts", "r", encoding="utf-8") as fh:
            for ln in fh:
                parts = ln.split("#")[0].split()
                if len(parts) < 2:
                    continue
                ip = parts[0]
                for name in parts[1:]:
                    if wanted is not None and name not in wanted:
                        continue
                    seen.setdefault(name, []).append(ip)
    except OSError:
        pass
    ips = {}
    for name, cand in seen.items():
        real = [c for c in cand if not c.startswith("127.")]
        ips[name] = (real or cand)[-1]
    for name in (wanted or []):
        if name in ips:
            continue
        r = run(["getent", "ahostsv4", name], timeout=15)
        cand = [l.split()[0] for l in r.stdout.splitlines() if l.split()]
        real = [c for c in cand if not c.startswith("127.")]
        if real or cand:
            ips[name] = (real or cand)[0]
    return ips


def ssh_node(node, argv, timeout=60):
    """在计算节点上以 root 执行 argv（本机直接执行）。"""
    if node == node_hostname():
        return run(argv, timeout=timeout)
    return run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                "-o", "StrictHostKeyChecking=accept-new", "-p", SSH_PORT,
                "root@" + node] + argv, timeout=timeout)


# ----------------------------------------------------------------------------
# ping / sinfo
# ----------------------------------------------------------------------------
def cmd_ping():
    out({"ok": True, "whoami": sh_out(["id", "-un"]), "host": node_hostname()})


def cmd_sinfo():
    part = partition_name()
    raw = sh_out(["sinfo", "-h", "-p", part, "-N", "-o", "%N|%T|%C|%G|%m|%a"],
                 timeout=30)
    fields = [ln.strip().split("|") for ln in raw.splitlines()]
    fields = [f for f in fields if len(f) >= 6]
    ips = nodes_ips([f[0] for f in fields])
    nodes = []
    for f in fields:
        name, state, cpus, gres, mem_mb, avail = f[0], f[1], f[2], f[3], f[4], f[5]
        ca = ci = co = ct = 0
        m = re.match(r"^(\d+)/(\d+)/(\d+)/(\d+)$", cpus)
        if m:
            ca, ci, co, ct = (int(x) for x in m.groups())
        try:
            mem = int(mem_mb)
        except ValueError:
            mem = 0
        nodes.append({
            "name": name, "state": state, "avail": avail,
            "cpus_alloc": ca, "cpus_idle": ci, "cpus_other": co, "cpus_total": ct,
            "mem_mb": mem, "gres": gres,
            "ip": ips.get(name, ""),
        })
    out({"ok": True, "partition": part, "nodes": nodes})


# ----------------------------------------------------------------------------
# 账号开通
# ----------------------------------------------------------------------------
def _ensure_admin_scripts():
    need = ["add-user.sh", "set-quota.sh", "show-quota.sh"]
    missing = [f for f in need if not os.path.exists(os.path.join(CLUSTER_ADMIN_DIR, f))]
    if missing:
        die("缺少 %s，请先安装第 7 章管理脚本到 %s" % (",".join(missing), CLUSTER_ADMIN_DIR))


def _copy_scripts_to_nodes(nodes):
    """把 /opt/cluster-admin/add-user.sh 同步到计算节点（幂等）。"""
    host = node_hostname()
    src = os.path.join(CLUSTER_ADMIN_DIR, "add-user.sh")
    for n in nodes:
        if n == host:
            continue
        # 先确保远程目录存在（幂等），再决定是否拷贝
        r0 = ssh_node(n, ["mkdir", "-p", CLUSTER_ADMIN_DIR], timeout=30)
        if r0.returncode != 0:
            return False, "无法在 %s 创建 %s: %s" % (n, CLUSTER_ADMIN_DIR,
                                                    r0.stderr.strip()[:200])
        r1 = ssh_node(n, ["bash", "-c", "test -x %s/add-user.sh" % CLUSTER_ADMIN_DIR],
                      timeout=30)
        if r1.returncode == 0:
            continue  # 已存在
        rr = run(["scp", "-P", SSH_PORT, "-o", "BatchMode=yes",
                  "-o", "StrictHostKeyChecking=accept-new",
                  src, "root@%s:%s/add-user.sh" % (n, CLUSTER_ADMIN_DIR)], timeout=60)
        if rr.returncode != 0:
            return False, "向 %s 同步 add-user.sh 失败: %s" % (n, rr.stderr.strip()[:300])
        ssh_node(n, ["chmod", "+x", "%s/add-user.sh" % CLUSTER_ADMIN_DIR], timeout=30)
    return True, ""


def cmd_provision_user(username, quota, skip_os):
    if not valid_user(username):
        die("非法用户名")
    if not QUOTA_RE.match(quota or ""):
        die("非法配额值: %s（例 500G / 1T）" % quota)
    host = node_hostname()
    nodes = compute_nodes()

    if skip_os:
        # 用户声称 OS 账号已存在 —— 校验并初始化目录
        r = run(["id", "-u", username])
        if r.returncode != 0:
            die("OS 账号 %s 在 %s 不存在，无法按“已存在”开通" % (username, host))
        uid = r.stdout.strip()
        if not uid.isdigit():
            die("读取 %s UID 失败" % username)
        for n in nodes:
            if n == host:
                continue
            rr = ssh_node(n, ["id", "-u", username])
            if rr.returncode != 0 or rr.stdout.strip() != uid:
                die("OS 账号 %s 在 %s 上不存在或 UID(%s)与 admin(%s) 不一致；"
                    "请先在计算节点建号（add-user.sh %s -u %s）"
                    % (username, n, rr.stdout.strip() or "?", uid, username, uid))
        _init_user_dirs(username, uid)
        # 「OS 账号已存在」这条路不会走 add-user.sh，必须在这里补会计关联，
        # 否则用户能申请但一提交就报 Invalid account or account/partition combination
        assoc_ok, assoc_err = _ensure_assoc(username)
        out({"ok": True, "mode": "existing", "username": username, "uid": int(uid),
             "assoc": "ok" if assoc_ok else "warning: %s" % assoc_err})
        return

    _ensure_admin_scripts()
    ok, err = _copy_scripts_to_nodes(nodes)
    if not ok:
        die(err)

    # 1) admin 建号（建家目录 + 配额 + sacctmgr）
    r = run([os.path.join(CLUSTER_ADMIN_DIR, "add-user.sh"), username, quota], timeout=120)
    if r.returncode != 0:
        die("admin 建号失败: %s" % r.stderr.strip()[:400] or r.stdout.strip()[:400])
    if "已存在，跳过" in r.stdout:
        die("用户名 %s 已存在于 admin，拒绝重复开通（如需开通已存在账号请勾选“OS 账号已存在”）" % username)

    r = run(["id", "-u", username])
    if r.returncode != 0:
        die("读取新用户 UID 失败")
    uid = r.stdout.strip()

    # 2) 计算节点建号（-u 强制同 UID）
    for n in nodes:
        if n == host:
            continue
        rr = ssh_node(n, [os.path.join(CLUSTER_ADMIN_DIR, "add-user.sh"),
                          username, "-u", uid], timeout=60)
        if rr.returncode != 0:
            die("计算节点 %s 建号失败: %s" % (n, rr.stderr.strip()[:400] or rr.stdout.strip()[:400]))

    _init_user_dirs(username, uid)
    # add-user.sh 已经建过关联；这里幂等再确认一次，避免脚本被改动后静默退化
    _ensure_assoc(username)
    out({"ok": True, "mode": "new", "username": username, "uid": int(uid),
         "quota": quota, "nodes": nodes})


def _ensure_assoc(username):
    """确保该用户在会计（sacctmgr）里有账户关联。**幂等**，返回 (ok, err)。

    为什么需要：集群开着 `AccountingStorageEnforce=associations` 时，没有关联的用户
    sbatch 会被直接拒掉，报
        Invalid account or account/partition combination specified
    经 `add-user.sh` 建号的用户会自动带上关联（脚本里有 `sacctmgr add user ... account=lab`），
    但**「OS 账号已存在」这条开通路径不走 add-user.sh**，历史上就漏了这一步 ——
    表现为"能登录门户、能点申请，但一提交就报上面那个错"。

    这里统一兜住：开通 / 初始化 / 提交前各确保一次。
    账户名取站点配置的 ACCOUNT（缺省 lab），与 add-user.sh 的 CLUSTER_ACCOUNT 对齐。
    """
    acct = SITE.get("ACCOUNT") or os.environ.get("CLUSTER_ACCOUNT") or "lab"
    r = run(["sacctmgr", "-n", "-P", "show", "assoc", "user=%s" % username,
             "format=Account"], timeout=30)
    if r.returncode != 0:
        return False, "查询会计关联失败: %s" % (r.stderr.strip() or r.stdout.strip())[:300]
    if r.stdout.strip():
        return True, ""
    rr = run(["sacctmgr", "-i", "add", "user", username,
              "account=%s" % acct, "qos=normal"], timeout=60)
    if rr.returncode != 0:
        return False, "建立会计关联失败: %s" % (rr.stderr.strip() or rr.stdout.strip())[:300]
    return True, ""


def _init_user_dirs(username, uid):
    home = user_home(username)
    for d in (os.path.join(home, ".ssh"), os.path.join(home, ".portal", "logs")):
        rr = run(["install", "-d", "-o", username, "-g", username, "-m", "700" if d.endswith(".ssh") else "755", d])
        if rr.returncode != 0:
            die("初始化 %s 失败: %s" % (d, rr.stderr.strip()[:300]))
    # 空 authorized_keys（若不存在）
    ak = os.path.join(home, ".ssh", "authorized_keys")
    if not os.path.exists(ak):
        with open(ak, "w", encoding="utf-8"):
            pass
        os.chown(ak, int(uid), int(uid))
        os.chmod(ak, 0o600)
    else:
        os.chmod(ak, 0o600)
    return True


def cmd_init_user(username):
    if not valid_user(username):
        die("非法用户名")
    r = run(["id", "-u", username])
    if r.returncode != 0:
        die("OS 账号 %s 在 %s 不存在" % (username, node_hostname()))
    uid = r.stdout.strip()
    _init_user_dirs(username, uid)
    assoc_ok, assoc_err = _ensure_assoc(username)
    out({"ok": True, "username": username, "uid": int(uid),
         "assoc": "ok" if assoc_ok else "warning: %s" % assoc_err})


def cmd_unprovision_user(username):
    """注销 OS 账号（删除家目录数据！）。仅供管理员手动清理/测试。"""
    if not valid_user(username):
        die("非法用户名")
    host = node_hostname()
    r = run(["id", "-u", username])
    if r.returncode != 0:
        out({"ok": True, "username": username, "skipped": "not-exists"})
        return
    uid = r.stdout.strip()
    import time
    # 杀掉该用户所有作业，等待队列清空（容器回收）
    run(["runuser", "-u", username, "--", "scancel", "-u", username], timeout=60)
    for _ in range(20):
        left = sh_out(["squeue", "-h", "-u", username, "-o", "%i"], timeout=30)
        if not left:
            break
        time.sleep(2)

    def _del_on_node(node, rm_home=False):
        argv = ["userdel"] + (["-r"] if rm_home else []) + [username]
        last = ssh_node(node, argv, timeout=60) if node != host else run(argv, timeout=120)
        for _ in range(5):
            if last.returncode == 0:
                return True
            time.sleep(3)
            last = ssh_node(node, argv, timeout=60) if node != host else run(argv, timeout=120)
        return last

    # 先删计算节点（进程/容器在本机，避免 admin 家目录删除时被占用）
    node_fail = []
    for n in compute_nodes():
        if n == host:
            continue
        if _del_on_node(n) is not True:
            node_fail.append(n)
    # admin: userdel -r（删除 NFS 家目录数据）
    ar = _del_on_node(host, rm_home=True)
    if ar is not True:
        node_fail.append(host)
    # 个人镜像目录 /share/images/<user> 一并清理（root 删除，/share 为 admin 本地盘）
    imgdir = os.path.join(IMAGES_ROOT, username)
    if os.path.isdir(imgdir):
        run(["rm", "-rf", imgdir], timeout=120)
    # sacctmgr 关联清理
    run(["sacctmgr", "-i", "delete", "user", "name=%s" % username], timeout=60)
    if node_fail:
        out({"ok": False, "error": "以下节点删除账号残留失败: %s，请手动 userdel %s"
             % (",".join(node_fail), username)}, code=1)
    out({"ok": True, "username": username, "uid": int(uid)})


def cmd_user_status(username):
    if not name_ok(username):
        die("非法用户名")
    host = node_hostname()
    uid = sh_out(["id", "-u", username])
    nodes = {}
    for n in compute_nodes():
        if n == host:
            nodes[n] = {"uid": uid if uid else None}
        else:
            r = ssh_node(n, ["id", "-u", username], timeout=30)
            nodes[n] = {"uid": r.stdout.strip() if r.returncode == 0 else None}
    assoc = sh_out(["sacctmgr", "-n", "-P", "show", "assoc",
                    "user=%s" % username, "format=Account"], timeout=30)
    home = user_home(username)
    out({"ok": True, "username": username, "uid_admin": uid or None,
         "exists": bool(uid), "nodes": nodes,
         "sacct_account": assoc.split("|")[0] if assoc else "",
         "home_exists": os.path.isdir(home)})


# ----------------------------------------------------------------------------
# 作业提交 / 停机 / 状态 / 日志
# ----------------------------------------------------------------------------
def _preflight_port_on_node(node, port):
    """端口占用预检（防门户外自启任务/他人占用冲突）。"""
    # ss 输出形如 0.0.0.0:28765 或 [::]:28765 —— 用 :port 后缀匹配
    check = ["bash", "-c", "ss -tlnH | grep -Eq ':%d( |$)' || exit 1" % port]
    r = ssh_node(node, check, timeout=20)
    return r.returncode != 0  # True=空闲


def cmd_submit():
    try:
        spec = json.load(sys.stdin)
    except Exception:
        die("stdin 不是合法 JSON")
    for k in ("user", "node", "image", "gpus", "cpus", "mem_gb", "walltime", "port"):
        if k not in spec:
            die("缺少字段 %s" % k)
    user = str(spec["user"])
    if not name_ok(user):
        die("非法用户名")
    if run_ok(["id", user]) is False:
        # id 存在性
        pass
    if run(["id", "-u", user]).returncode != 0:
        die("OS 账号 %s 不存在" % user)

    host = node_hostname()
    nodes = compute_nodes()
    node = str(spec["node"]).strip()   # 空串=由 Slurm 自动调度（不 -w、不按节点预检）
    if node and node not in nodes:
        die("节点 %s 不在分区内（可用: %s）" % (node, ",".join(nodes)))

    image = str(spec["image"])
    if not image.startswith("/share/images/") or not image.endswith(".sqsh") \
            or not os.path.isfile(image):
        die("镜像路径非法或不存在: %s" % image)

    try:
        gpus = int(spec["gpus"])
        cpus = int(spec["cpus"])
        mem_gb = int(spec["mem_gb"])
        port = int(spec["port"])
    except (TypeError, ValueError):
        die("gpus/cpus/mem_gb/port 必须是整数")
    if not (0 <= gpus <= 8):
        die("gpus 超出范围 0-8（0=纯 CPU；上限按单节点最多 8 卡）")
    if not (1 <= cpus <= 64):
        die("cpus 超出范围 1-64")
    if not (1 <= mem_gb <= 256):
        die("mem_gb 超出范围 1-256")
    if not (10000 <= port <= 65535):
        die("端口必须在 10000-65535")
    walltime = str(spec["walltime"])
    if not HOURS_RE.match(walltime):
        die("walltime 格式须为 HH:MM:SS")

    job_name = str(spec.get("job_name", "portal-ssh"))
    if not re.match(r"^[A-Za-z0-9_.-]{1,40}$", job_name):
        die("非法作业名")

    # 容量粗校验（仅指定节点时；自动调度交给 Slurm）
    if node:
        sinfo_raw = sh_out(["sinfo", "-h", "-p", partition_name(), "-N",
                            "-o", "%N|%C|%m|%G"], timeout=30)
        node_cpus = node_mem = node_gpus = 0
        for ln in sinfo_raw.splitlines():
            f = ln.strip().split("|")
            if f and f[0] == node:
                m = re.match(r"^(\d+)/(\d+)/(\d+)/(\d+)$", f[1])
                if m:
                    node_cpus = int(m.group(4))
                try:
                    node_mem = int(f[2])
                except ValueError:
                    node_mem = 0
                gm = re.search(r"gpu:[^:,]+:(\d+)", f[3] or "")
                if gm:
                    node_gpus = int(gm.group(1))
                break
        if cpus > node_cpus:
            die("cpus=%d 超过 %s 可用核数 %d" % (cpus, node, node_cpus))
        if mem_gb * 1024 > node_mem:
            die("mem=%dG 超过 %s 内存 %dMB" % (mem_gb, node, node_mem))
        if gpus > node_gpus:
            die("gpus=%d 超过 %s 可用 GPU 数 %d" % (gpus, node, node_gpus))
        if not _preflight_port_on_node(node, port):
            die("端口 %d 在 %s 上已被占用（可能与门户外任务冲突），请换端口" % (port, node))

    home = user_home(user)
    if not os.path.isdir(home):
        die("用户家目录 %s 不存在" % home)
    logdir = os.path.join(home, ".portal", "logs")
    run(["install", "-d", "-o", user, "-g", user, "-m", "755", logdir], timeout=30)

    # 兜底：确保会计关联存在。缺关联时 sbatch 会以
    # "Invalid account or account/partition combination specified" 失败；
    # 这里失败也不中止，交给 sbatch 报出更准确的错误。
    _ensure_assoc(user)

    # 命名容器（--container-name=portal → pyxis_<jobid>_portal）：使容器 rootfs 成为
    # 计算节点 ENROOT_DATA_PATH 下普通可读写的目录（而非临时 overlay），门户才能随时把
    # “当前容器状态”导出成 .sqsh 个人镜像（save-image）。--container-writable 保证容器内
    # 修改确实落盘到该 rootfs。作业结束（无论停机/到期）pyxis 会自动清理该目录。
    argv = ["sbatch", "--parsable", "-p", partition_name(), "-N", "1",
            "-J", job_name, "-c", str(cpus), "--mem=%dG" % mem_gb,
            "--time=" + walltime, "-o", os.path.join(logdir, "%j.out"),
            # 必须显式指定作业工作目录。不给的话 Slurm 用"提交者进程的 cwd"——
            # 门户服务以 /opt/cluster-portal 为 cwd（systemd WorkingDirectory），
            # 该目录只存在于管理节点；作业落到计算节点就会 chdir 失败并回退 /tmp：
            #   error: couldn't chdir to `/opt/cluster-portal': No such file or directory
            # 家目录在 NFS 上、各节点都有，是最自然的工作目录。
            "--chdir=" + home,
            # PWD 也要一起纠正：--export=ALL 会把门户进程的 PWD(=/opt/cluster-portal)
            # 透传进来，和实际 cwd 不一致，部分程序会据此走错路径。
            "--export=ALL,SSH_PORT=%d,PWD=%s" % (port, home),
            "--container-image=" + image,
            "--container-env=SSH_PORT",
            "--container-mounts=%s:%s" % (home, home),
            "--container-name=portal",
            "--container-writable",
            "--wrap", "/opt/start_ssh.sh"]
    if node:
        argv.insert(argv.index("-J"), "-w")
        argv.insert(argv.index("-J"), node)
    if gpus >= 1:
        argv.insert(argv.index("-J"), "--gres=gpu:%d" % gpus)
    # 显式设置提交环境 HOME/USER，避免 runuser/服务目录把 HOME 带进作业（--export=ALL 会透传）
    r = run(["runuser", "-u", user, "--"] + argv, timeout=60,
            env={"HOME": home, "USER": user, "LOGNAME": user})
    if r.returncode != 0:
        die("sbatch 提交失败: %s" % (r.stderr.strip()[:400] or r.stdout.strip()[:400]))
    job_id_txt = (r.stdout or r.stderr or "").strip().splitlines()[-1]
    try:
        job_id = int(job_id_txt)
    except ValueError:
        die("无法解析 sbatch 输出 jobid: %r" % job_id_txt)
    out({"ok": True, "job_id": job_id,
         "log_path": os.path.join(logdir, "%d.out" % job_id),
         "command": " ".join(argv)})


def cmd_kill(user, job_id):
    if not name_ok(user):
        die("非法用户名")
    try:
        job_id = int(job_id)
    except ValueError:
        die("非法 jobid")
    if run(["id", "-u", user]).returncode != 0:
        die("OS 账号 %s 不存在" % user)
    owner = sh_out(["squeue", "-h", "-j", str(job_id), "-o", "%u"], timeout=30)
    if not owner:
        # 已不在队列 → 查历史
        st = sh_out(["sacct", "-n", "-X", "-P", "-j", str(job_id),
                     "-o", "State"], timeout=30)
        state = (st.strip().splitlines() or [""])[-1] or "UNKNOWN"
        out({"ok": True, "already_ended": True, "state": state})
        return
    if owner != user:
        die("作业 %d 属主为 %s，非 %s" % (job_id, owner, user))
    r = run(["runuser", "-u", user, "--", "scancel", str(job_id)], timeout=60)
    if r.returncode != 0:
        die("scancel 失败: %s" % r.stderr.strip()[:300])
    out({"ok": True, "job_id": job_id, "cancelled": True})


def cmd_job_state(user, job_id):
    if not name_ok(user):
        die("非法用户名")
    try:
        job_id = int(job_id)
    except ValueError:
        die("非法 jobid")
    active = sh_out(["squeue", "-h", "-j", str(job_id),
                     "-o", "%T|%N|%M|%j"], timeout=30)
    if active:
        f = active.split("|")
        out({"ok": True, "active": True, "state": f[0], "node": f[1] if len(f) > 1 else "",
             "elapsed": f[2] if len(f) > 2 else "", "name": f[3] if len(f) > 3 else ""})
        return
    st = sh_out(["sacct", "-n", "-X", "-P", "-j", str(job_id),
                 "-o", "State,NodeList,Start"], timeout=30)
    lines = [x for x in st.strip().splitlines() if x.strip()]
    if not lines:
        out({"ok": True, "active": False, "state": "UNKNOWN"})
        return
    f = lines[-1].split("|")
    state = f[0].split("+")[0].split(" ")[0]
    out({"ok": True, "active": False, "state": state,
         "node": f[1] if len(f) > 1 else "", "start": f[2] if len(f) > 2 else ""})


def cmd_log(user, job_id, lines):
    if not name_ok(user):
        die("非法用户名")
    try:
        job_id = int(job_id)
        lines = max(1, min(int(lines), 5000))
    except ValueError:
        die("非法参数")
    path = os.path.join(user_home(user), ".portal", "logs", "%d.out" % job_id)
    if not os.path.isfile(path):
        die("日志文件不存在: %s" % path)
    try:
        with open(path, "rb") as fh:
            fh.seek(0, 2)
            size = fh.tell()
            fh.seek(max(0, size - lines * 4096))
            data = fh.read()
    except OSError as e:
        die("读取日志失败: %s" % e)
    text = data.decode("utf-8", "replace")
    tail = text.splitlines()[-lines:]
    out({"ok": True, "job_id": job_id, "path": path,
         "text": "\n".join(tail), "total_lines": text.count("\n")})



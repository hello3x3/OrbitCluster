def _preflight_port_on_node(node, port):
    """端口占用预检（防门户外自启任务/他人占用冲突）。"""
    # ss 输出形如 0.0.0.0:28765 或 [::]:28765 —— 用 :port 后缀匹配
    check = ["bash", "-c", "ss -tlnH | grep -Eq ':%d( |$)' || exit 1" % port]
    r = ssh_node(node, check, timeout=20)
    return r.returncode != 0  # True=空闲


def cmd_submit():
    try:
        spec = json.load(sys.stdin)
    except Exception:
        die("stdin 不是合法 JSON")
    for k in ("user", "node", "image", "gpus", "cpus", "mem_gb", "walltime", "port"):
        if k not in spec:
            die("缺少字段 %s" % k)
    user = str(spec["user"])
    # 保留账号（root/portal/slurm…）绝不能"以它的身份"提交作业：
    # 它的家目录就是 /root 或 /var/lib/cluster-portal，会被 --container-mounts 挂进容器。
    if not valid_user(user):
        die("非法用户名或系统保留账号: %s" % user)
    if run(["id", "-u", user]).returncode != 0:
        die("OS 账号 %s 不存在" % user)

    # 可选 account（多账户）：门户只是 UX 校验，**最终校验在这里**。
    # 空/缺失 = 不传 --account，交给 Slurm 用该用户的 defaultaccount（旧行为）。
    # 传了就必须确实是该用户的关联账户 —— 助手绝不会自动给用户新增关联
    # （否则门户被攻破后可以自己开账户绕开配额/优先级）。
    acct = spec.get("account")
    acct = str(acct).strip() if acct is not None else ""
    if acct:
        if not valid_account(acct):
            die("非法账户名: %s（须匹配 %s）" % (acct, ACCOUNT_RE.pattern))
        user_accts = _user_account_names(user)
        if user_accts is None:
            die("查询 %s 的会计关联失败（sacctmgr 不可用？）" % user)
        if acct not in user_accts:
            die("用户 %s 不在账户 %s 下，拒绝提交（助手不会自动新增关联；"
                "当前账户: %s）" % (user, acct, ",".join(user_accts) or "无"))

    host = node_hostname()
    nodes = compute_nodes()
    node = str(spec["node"]).strip()   # 空串=由 Slurm 自动调度（不 -w、不按节点预检）
    if node and node not in nodes:
        die("节点 %s 不在分区内（可用: %s）" % (node, ",".join(nodes)))

    image = str(spec["image"])
    if not image.startswith(IMAGES_ROOT + "/") or not image.endswith(".sqsh"):
        die("镜像路径非法: %s" % image)
    if ".." in image.split("/") or "//" in image:
        die("镜像路径非法（含 .. 或 //）: %s" % image)
    ierr = _check_regular_outside_home(image, (0, _uid_of(user)))
    if ierr:
        die(ierr)
    image = os.path.realpath(image)

    try:
        gpus = int(spec["gpus"])
        cpus = int(spec["cpus"])
        mem_gb = int(spec["mem_gb"])
        port = int(spec["port"])
    except (TypeError, ValueError):
        die("gpus/cpus/mem_gb/port 必须是整数")
    if not (0 <= gpus <= 8):
        die("gpus 超出范围 0-8（0=纯 CPU；上限按单节点最多 8 卡）")
    if not (1 <= cpus <= 64):
        die("cpus 超出范围 1-64")
    if not (1 <= mem_gb <= 256):
        die("mem_gb 超出范围 1-256")
    if not (10000 <= port <= 65535):
        die("端口必须在 10000-65535")
    walltime = str(spec["walltime"])
    if not HOURS_RE.match(walltime):
        die("walltime 格式须为 HH:MM:SS")

    job_name = str(spec.get("job_name", "portal-ssh"))
    if not re.match(r"^[A-Za-z0-9_.-]{1,40}$", job_name):
        die("非法作业名")

    # 容量粗校验（仅指定节点时；自动调度交给 Slurm）
    if node:
        sinfo_raw = sh_out(["sinfo", "-h", "-p", partition_name(), "-N",
                            "-o", "%N|%C|%m|%G"], timeout=30)
        node_cpus = node_mem = node_gpus = 0
        for ln in sinfo_raw.splitlines():
            f = ln.strip().split("|")
            if f and f[0] == node:
                m = re.match(r"^(\d+)/(\d+)/(\d+)/(\d+)$", f[1])
                if m:
                    node_cpus = int(m.group(4))
                try:
                    node_mem = int(f[2])
                except ValueError:
                    node_mem = 0
                gm = re.search(r"gpu:[^:,]+:(\d+)", f[3] or "")
                if gm:
                    node_gpus = int(gm.group(1))
                break
        if cpus > node_cpus:
            die("cpus=%d 超过 %s 可用核数 %d" % (cpus, node, node_cpus))
        if mem_gb * 1024 > node_mem:
            die("mem=%dG 超过 %s 内存 %dMB" % (mem_gb, node, node_mem))
        if gpus > node_gpus:
            die("gpus=%d 超过 %s 可用 GPU 数 %d" % (gpus, node, node_gpus))
        if not _preflight_port_on_node(node, port):
            die("端口 %d 在 %s 上已被占用（可能与门户外任务冲突），请换端口" % (port, node))

    home, herr = checked_home(user)
    if herr:
        die(herr)
    if not os.path.isdir(home):
        die("用户家目录 %s 不存在" % home)
    logdir = os.path.join(home, ".portal", "logs")
    # 不用 install -d（会跟随软链改真实目录的属主/权限）
    if os.path.isdir(os.path.join(home, ".portal")):
        _ensure_user_dir(user, _uid_of(user), logdir, 0o755)
    else:
        _init_user_dirs(user, _uid_of(user))

    # 旧行为兜底：**没有指定 account** 时，确保站点默认账户的关联存在。
    # 缺关联时 sbatch 会以 "Invalid account or account/partition combination specified"
    # 失败；这里失败也不中止（交给 sbatch 报更准确的错误）。
    # 指定了 account 时**绝不**补关联 —— 上面的成员校验已经明确拒绝未加入的账户。
    if not acct:
        _ensure_assocs(user, None, None, set_default=False)

    # 额外挂载（NAS/数据集）的源目录必须在**每台节点**上都在，否则作业落到缺挂载的那台
    # 会在容器启动阶段 bind 失败。这里提前拦，给出可执行的提示。
    _check_extra_mount_sources()

    # 命名容器（--container-name=portal → pyxis_<jobid>_portal）：使容器 rootfs 成为
    # 计算节点 ENROOT_DATA_PATH 下普通可读写的目录（而非临时 overlay），门户才能随时把
    # “当前容器状态”导出成 .sqsh 个人镜像（save-image）。--container-writable 保证容器内
    # 修改确实落盘到该 rootfs。作业结束（无论停机/到期）pyxis 会自动清理该目录。
    argv = ["sbatch", "--parsable", "-p", partition_name(), "-N", "1"]
    # 多账户：显式 --account=<acct>（必须放在 --wrap 之前，且在 sbatch 选项区）。
    if acct:
        argv.append("--account=%s" % acct)
    argv += [
            "-J", job_name, "-c", str(cpus), "--mem=%dG" % mem_gb,
            "--time=" + walltime, "-o", os.path.join(logdir, "%j.out"),
            # 必须显式指定作业工作目录。不给的话 Slurm 用"提交者进程的 cwd"——
            # 门户服务以 /opt/cluster-portal 为 cwd（systemd WorkingDirectory），
            # 该目录只存在于管理节点；作业落到计算节点就会 chdir 失败并回退 /tmp：
            #   error: couldn't chdir to `/opt/cluster-portal': No such file or directory
            # 家目录在 NFS 上、各节点都有，是最自然的工作目录。
            "--chdir=" + home,
            # 环境只导出**显式白名单**：历史写法 --export=ALL 会把本助手进程的整份环境
            # （sudo 的 SUDO_* 、门户服务的 PORTAL_* 等）带进用户容器；现在只带这几个。
            "--export=HOME=%s,USER=%s,LOGNAME=%s,PATH,PWD=%s,SSH_PORT=%d"
            % (home, user, user, home, port),
            "--container-image=" + image,
            "--container-env=SSH_PORT",
            # 家目录 + site.conf 里配的额外挂载（NAS/数据集）。额外挂载**只来自服务端配置**，
            # 见文件头部 EXTRA_MOUNTS 的说明；默认 ro，避免用户把共享盘写坏。
            "--container-mounts=" + _container_mounts_arg(home),
            "--container-name=portal",
            "--container-writable",
            "--wrap", "/opt/start_ssh.sh"]
    if node:
        argv.insert(argv.index("-J"), "-w")
        argv.insert(argv.index("-J"), node)
    if gpus >= 1:
        argv.insert(argv.index("-J"), "--gres=gpu:%d" % gpus)
    # 安全约束：绝不加 --container-remap-root（默认也不 remap，所以无需 --no-...）。
    # 容器一旦以 root 起来，sshd 就是 root 身份 + enroot 共享宿主机网络，风险太大。
    if any(str(a).startswith("--container-remap-root") for a in argv):
        die("内部错误：门户作业禁止使用 --container-remap-root（会让容器变 root 模式）")
    # 显式设置提交环境 HOME/USER，避免 runuser/服务目录把 HOME 带进作业（--export=ALL 会透传）
    r = run(["runuser", "-u", user, "--"] + argv, timeout=60,
            env={"HOME": home, "USER": user, "LOGNAME": user})
    if r.returncode != 0:
        die("sbatch 提交失败: %s" % (r.stderr.strip()[:400] or r.stdout.strip()[:400]))
    job_id_txt = (r.stdout or r.stderr or "").strip().splitlines()[-1]
    try:
        job_id = int(job_id_txt)
    except ValueError:
        die("无法解析 sbatch 输出 jobid: %r" % job_id_txt)
    out({"ok": True, "job_id": job_id,
         "log_path": os.path.join(logdir, "%d.out" % job_id),
         "command": " ".join(argv)})


def cmd_kill(user, job_id):
    if not valid_user(user):
        die("非法用户名或系统保留账号: %s" % user)
    try:
        job_id = int(job_id)
    except ValueError:
        die("非法 jobid")
    if run(["id", "-u", user]).returncode != 0:
        die("OS 账号 %s 不存在" % user)
    owner = sh_out(["squeue", "-h", "-j", str(job_id), "-o", "%u"], timeout=30)
    if not owner:
        # 已不在队列 → 查历史
        st = sh_out(["sacct", "-n", "-X", "-P", "-j", str(job_id),
                     "-o", "State"], timeout=30)
        state = (st.strip().splitlines() or [""])[-1] or "UNKNOWN"
        out({"ok": True, "already_ended": True, "state": state})
        return
    if owner != user:
        die("作业 %d 属主为 %s，非 %s" % (job_id, owner, user))
    r = run(["runuser", "-u", user, "--", "scancel", str(job_id)], timeout=60)
    if r.returncode != 0:
        die("scancel 失败: %s" % r.stderr.strip()[:300])
    out({"ok": True, "job_id": job_id, "cancelled": True})


def cmd_job_state(user, job_id):
    if not valid_user(user):
        die("非法用户名或系统保留账号: %s" % user)
    try:
        job_id = int(job_id)
    except ValueError:
        die("非法 jobid")
    active = sh_out(["squeue", "-h", "-j", str(job_id),
                     "-o", "%T|%N|%M|%j"], timeout=30)
    if active:
        f = active.split("|")
        out({"ok": True, "active": True, "state": f[0], "node": f[1] if len(f) > 1 else "",
             "elapsed": f[2] if len(f) > 2 else "", "name": f[3] if len(f) > 3 else ""})
        return
    st = sh_out(["sacct", "-n", "-X", "-P", "-j", str(job_id),
                 "-o", "State,NodeList,Start"], timeout=30)
    lines = [x for x in st.strip().splitlines() if x.strip()]
    if not lines:
        out({"ok": True, "active": False, "state": "UNKNOWN"})
        return
    f = lines[-1].split("|")
    state = f[0].split("+")[0].split(" ")[0]
    out({"ok": True, "active": False, "state": state,
         "node": f[1] if len(f) > 1 else "", "start": f[2] if len(f) > 2 else ""})


def cmd_log(user, job_id, lines):
    if not valid_user(user):
        die("非法用户名或系统保留账号: %s" % user)
    try:
        job_id = int(job_id)
        lines = max(1, min(int(lines), 5000))
    except ValueError:
        die("非法参数")
    home, herr = checked_home(user)
    if herr:
        die(herr)
    path = os.path.join(home, ".portal", "logs", "%d.out" % job_id)
    if not os.path.lexists(path):
        die("日志文件不存在: %s" % path)
    # 安全：绝不能用 os.path.isfile()+open() —— 用户可以在自己家目录里把
    # <jobid>.out 换成软链（例如指向 /etc/cluster-portal/users.passwd），
    # root 一旦跟随就变成"任意 root 文件读"。_open_user_file 会拒绝软链/非普通文件/他人所有。
    fd, oerr = _open_user_file(user, path, os.O_RDONLY)
    if oerr:
        die("读取日志失败：%s" % oerr)
    try:
        size = os.fstat(fd).st_size
        start = max(0, size - lines * 4096)
        os.lseek(fd, start, os.SEEK_SET)
        data = os.read(fd, max(0, size - start))
    except OSError as e:
        die("读取日志失败: %s" % e)
    finally:
        os.close(fd)
    text = data.decode("utf-8", "replace")
    tail = text.splitlines()[-lines:]
    out({"ok": True, "job_id": job_id, "path": path,
         "text": "\n".join(tail), "total_lines": text.count("\n")})


# ----------------------------------------------------------------------------
# 容器 sshd 是否就绪（门户「启动中 → 运行中」的判据）
# ----------------------------------------------------------------------------
# start_ssh.sh 在**确认 /proc/net/tcp 里端口处于 LISTEN 之后**才打印这一行；
# 所以"日志里有它" = 容器的 sshd 真的起来了。作业日志在用户家目录（750）下，
# 门户进程读不到，只能由 root 助手读（这里是本地文件读，不 ssh、不联网）。
SSH_READY_MARK = "[start_ssh] sshd 实际监听端口:"
# 就绪横幅必须带**非空 PID** 才算数：sshd 抢不到端口时会 daemonize 并以 0 退出，
# start_ssh.sh 拿不到 pidfile，于是 PID 为空 —— 而它那句"是否在监听"读的是
# /proc/net/tcp，那是**整个网络命名空间**（= 宿主机）的表，别人占着同一个端口
# 也会显示"有人在听"。所以 `(PID=)` 恰恰是"端口被别的进程占用"的指纹。
SSH_BANNER_RE = re.compile(r"\[start_ssh\] sshd 实际监听端口:\s*(\d+)\s*\(PID=(\d*)\)")
# 启动失败的指纹（脚本自己打"启动失败:"；绑定失败时 sshd 会打 Bind/Address already in use）
SSH_FAIL_RE = re.compile(
    r"\[start_ssh\] 启动失败"                       # 启动失败横幅
    r"|\[start_ssh\] sshd 启动失败"                 # 启动失败横幅的另一种写法
    r"|Bind to port .* failed"                       # sshd 自己打的
    r"|Address already in use"                       # 内核 EADDRINUSE
    r"|sshd: no hostkeys available")
SSH_READY_HEAD_BYTES = 65536      # 就绪横幅在文件开头；只读头部，别把几十 MB 的日志全读进来


def _ssh_ready_verdict(text):
    """从作业日志头部判断容器里的 sshd 到底起没起来。

    返回 (ready, failed, reason)：
      ready   —— 我们自己的 sshd 真的在监听（横幅带非空 PID）
      failed  —— 已经能确定起不来了（端口被占 / sshd 报错 / 横幅 PID 为空）
    只认 PID 非空的横幅：见 SSH_BANNER_RE 上面的说明。
    """
    if SSH_FAIL_RE.search(text or ""):
        return False, True, "port-conflict"
    m = SSH_BANNER_RE.search(text or "")
    if not m:
        return False, False, "starting"          # 还没到时候 / 日志里还没有横幅
    if not m.group(2):
        # 横幅在但 PID 空：端口被别的进程占着，那不是在监听我们的 sshd
        return False, True, "port-conflict"
    return True, False, "ok"


def cmd_ssh_ready(user, job_id):
    """读作业日志头部，判断容器里的 sshd 是否已监听。"""
    if not valid_user(user):
        die("非法用户名或系统保留账号: %s" % user)
    try:
        job_id = int(job_id)
    except ValueError:
        die("非法 jobid")
    home, herr = checked_home(user)
    if herr:
        die(herr)
    path = os.path.join(home, ".portal", "logs", "%d.out" % job_id)
    if not os.path.lexists(path):
        # 日志还没落地：Slurm 刚起容器、文件尚未创建，算"未就绪"（页面显示启动中）
        out({"ok": True, "ready": False, "job_id": job_id, "reason": "no-log"})
        return
    # 安全：与 cmd_log 同一条规矩 —— 用户可以在自己家目录里把 <jobid>.out 换成软链
    # （例如指向 /etc/cluster-portal/users.passwd），root 一旦跟随就是"任意 root 文件读"。
    # _open_user_file 拒绝软链/非普通文件/属主异常。
    fd, oerr = _open_user_file(user, path, os.O_RDONLY)
    if oerr:
        die("读取日志失败：%s" % oerr)
    try:
        data = os.read(fd, SSH_READY_HEAD_BYTES)
    except OSError as e:
        die("读取日志失败: %s" % e)
    finally:
        os.close(fd)
    ready, failed, reason = _ssh_ready_verdict(data.decode("utf-8", "replace"))
    out({"ok": True, "ready": ready, "failed": failed, "reason": reason, "job_id": job_id})



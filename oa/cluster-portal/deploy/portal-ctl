#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
portal-ctl —— 集群门户特权助手（root 执行，被 web 服务通过 sudoers 白名单调用）

所有命令的输出统一为 JSON（stdout），字段含 ok=True/False。本脚本只做
"经过严格校验的有限动作"，绝不 eval/拼接任意 shell。web 服务（portal 用户）
仅能通过 sudo 调用本脚本，无法直接以 root 跑其它命令。

命令一览（见 main()）:
  ping                健康自检
  sinfo               节点状态(含 IP / 内存 / gres / 分区)
  provision-user <u> <quota> [--skip-os] [--uid N]
                                           开通集群账号(admin+计算节点)或仅初始化；
                                           --uid 可把账号钉在指定 UID（测试/CI 用
                                           保留号段 59000-59999，避免占用真实用户号段）
  unprovision-user <u>                     注销集群账号(危险，仅测试/清理用)
  init-user <u>                            仅初始化已有 OS 用户的 .ssh/.portal 目录
  ensure-assoc <u>                         确保该用户在会计里有账户关联(幂等；缺关联会
                                           导致 sbatch 报 Invalid account...)
  user-status <u>                          查看账号在管理节点/各节点的状态
  submit               读取 stdin JSON, 以该用户身份 sbatch 提交容器交互作业
  kill <u> <jobid>                         停机(校验属主后 scancel)
  job-state <u> <jobid>                    查单个作业状态(squeue→sacct 回退)
  log <u> <jobid> [lines]                  读取作业输出日志尾部
  rm-log <u> <jobid>                      删除某作业日志文件(清理已删除实例残留)
  save-image <u> <jobid> <name> [force]   把运行中容器的当前状态保存为个人镜像
                                          (/share/images/<u>/<name>.sqsh)
                                          是否计入 /share 配额取决于站点：/share/images 与
                                          /share 同一文件系统则计入，独立盘(如本站的 nvme)
                                          则不计入、需单独关注该盘容量
  images <u>                              列出 /share/images/<u> 下该用户个人镜像
  get-keys <u> / set-keys <u>              读写 authorized_keys
  quota <u>                                读取 /share 磁盘配额(实际 OS 值)
  quota-all                                批量读取 /share 全部用户配额
  set-quota <u> <大小|不限>                设置 /share 配额(实际 OS 值, 软=硬;
                                           「不限」= 清除限额)
  slurm-info <u>                           读取 slurm 关联/QoS/优先级/限额(经 sacctmgr)
"""
import json
import os
import re
import stat
import subprocess
import sys
import tempfile

USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
QUOTA_RE = re.compile(r"^[1-9][0-9]{0,2}[GgTtMm]$")
# 「不限配额」的规范写法；另接受 0 / UNLIMITED 作为输入别名
QUOTA_UNLIMITED = "不限"
_QUOTA_UNLIMITED_RE = re.compile(r"^(?:不限|0|UNLIMITED)$", re.IGNORECASE)


def quota_valid(size):
    """额度是否合法：'100G' / '1T' / '200M' 之类，或「不限」。"""
    s = (size or "").strip()
    return bool(QUOTA_RE.match(s) or _QUOTA_UNLIMITED_RE.match(s))
HOURS_RE = re.compile(r"^\d{1,3}:\d{2}:\d{2}$")
IMG_NAME_RE = re.compile(r"^[A-Za-z0-9_]{1,64}$")
PUBKEY_RE = re.compile(
    r"^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp(256|384|521)|"
    r"sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) "
    r"[A-Za-z0-9+/]{20,}={0,2}( [^\r\n]{0,200})?$"
)
# 系统/保留账号：绝不允许门户"以它的身份"做事（提交作业、写它的 authorized_keys、
# 注销它）。注意这里只用**前缀**匹配 systemd-*，不要写成字面量 "systemd-*"
# —— 字面量永远匹配不上，等于名单里少了一条规则。
RESERVED = {"root", "portal", "slurm", "nobody", "daemon", "bin", "sys", "games",
            "man", "lp", "mail", "news", "uucp", "proxy", "www-data", "backup",
            "list", "irc", "_apt"}
RESERVED_PREFIX = ("systemd-", "nvidia-", "ntp", "chrony", "messagebus", "polkitd",
                   "mysql", "postgres", "sshd", "dnsmasq", "landscape")


def is_reserved(u):
    """是否系统/保留账号（精确名 + 前缀）。"""
    u = u or ""
    return u in RESERVED or u.startswith(RESERVED_PREFIX)


CLUSTER_ADMIN_DIR = "/opt/cluster-admin"
SHARE_HOME = "/share/home"

# ----------------------------------------------------------------------------
# 站点配置（与 portalapp/siteconf.py 读同一个文件，保持两端行为一致）
#   /etc/cluster-portal/site.conf  每行 KEY=VALUE，# 起注释
#   本站点认的键：SSH_PORT <其它键由门户进程使用>
# 节点名不在这里配置：一律经 sinfo 运行时探测，节点 IP 从 /etc/hosts 解析。
# ----------------------------------------------------------------------------
SITE_CONF = os.environ.get("PORTAL_SITE_CONF", "/etc/cluster-portal/site.conf")


def _load_site_conf(path):
    cfg = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for raw in fh:
                ln = raw.split("#", 1)[0].strip()
                if not ln or "=" not in ln:
                    continue
                k, v = ln.split("=", 1)
                k = k.strip().upper()
                if k:
                    cfg[k] = v.strip()
    except OSError:
        pass
    return cfg


SITE = _load_site_conf(SITE_CONF)
# 节点间 ssh 端口：环境变量 > 站点配置 > 默认 2180
SSH_PORT = str(os.environ.get("PORTAL_SSH_PORT") or SITE.get("SSH_PORT") or "2180")


def user_home(username):
    """真实 OS 家目录（root 的 /root 等也能正确解析），失败回退 /share/home/<user>。"""
    r = run(["getent", "passwd", username], timeout=20)
    parts = r.stdout.split(":")
    if r.returncode == 0 and len(parts) >= 7 and parts[0] == username and parts[5]:
        return parts[5]
    return os.path.join(SHARE_HOME, username)
CTL = "portal-ctl"
IMAGES_ROOT = "/share/images"


def out(obj, code=0):
    try:
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    except BrokenPipeError:
        pass
    sys.exit(code)


def die(msg):
    out({"ok": False, "error": str(msg)}, code=1)


def run(argv, timeout=120, input_text=None, env=None, **kw):
    """run a command, return CompletedProcess (never raises on rc)."""
    full_env = dict(os.environ)
    full_env["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    if env:
        full_env.update(env)
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout,
                              input=input_text, env=full_env, **kw)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", "timeout after %ss" % timeout)


def run_ok(argv, timeout=120, input_text=None):
    r = run(argv, timeout=timeout, input_text=input_text)
    return r.returncode == 0


def sh_out(argv, timeout=120):
    r = run(argv, timeout=timeout)
    return r.stdout.strip() if r.returncode == 0 else ""


# ----------------------------------------------------------------------------
# 安全路径原语（重要）
#
# 背景（真实可利用的漏洞，不要删掉这段注释）：
#   用户家目录在 NFS 上，并且被 **rw 挂进他自己的容器**（--container-mounts=$HOME:$HOME），
#   所以「用户可以在自己家目录里任意创建符号链接」。而本助手是以 root 执行的，
#   一旦对用户可写路径直接用 open()/os.path.isfile()/install -d，就会出现：
#     * ln -s /etc/cluster-portal/users.passwd ~/.portal/logs/<jobid>.out
#         → 用户在网页点「日志」，root 跟随软链把全站明文口令读出来返回（任意 root 文件读）
#     * ln -s /root/.ssh/authorized_keys ~/.ssh/authorized_keys.portal-tmp
#         → root 把攻击者公钥写进 /root/.ssh/authorized_keys（任意 root 文件写）
#     * ln -s /etc/cron.d ~/.portal/logs  然后提交作业
#         → install -d 跟随软链，把 /etc/cron.d 的属主/权限改成该用户
#   因此对**任何**位于用户家目录之下的路径，一律：
#     ① 从家目录起逐级 lstat，任何一级是符号链接就拒绝；
#     ② realpath 必须仍在该用户家目录之内；
#     ③ 读文件用 O_NOFOLLOW 且必须是普通文件、属主是本人或 root；
#     ④ 写文件先在 root 私有目录建临时文件，再 os.replace（替换目录项本身，不跟随软链）。
# ----------------------------------------------------------------------------

HOME_RE = re.compile(r"^/[A-Za-z0-9_./-]+$")


def _uid_of(username):
    r = run(["id", "-u", username], timeout=20)
    v = (r.stdout or "").strip()
    return int(v) if r.returncode == 0 and v.isdigit() else None


def checked_home(username):
    """取用户家目录并做基本校验（必须是绝对路径、无空格/元字符）。

    返回 (home, err)：家目录会被拼进 ssh 远端命令与 sbatch 的 --export/--chdir，
    含空格或 shell 元字符会破坏参数边界，因此这里直接拒绝。
    """
    home = user_home(username)
    if not HOME_RE.match(home or ""):
        return None, "家目录路径异常（含空格或特殊字符），已拒绝：%r" % home
    return home, None


def _link_free_chain(username, path):
    """从用户家目录逐级 lstat 到 path；任一级是符号链接即返回错误串，否则 None。

    path 尚不存在是允许的（交由创建逻辑负责），但**已存在的每一级**都必须是真目录/真文件。
    """
    home = os.path.realpath(user_home(username))
    p = os.path.abspath(path)
    if p != home and not p.startswith(home.rstrip("/") + os.sep):
        return "%s 不在用户家目录 %s 之内" % (p, home)
    rel = os.path.relpath(p, home)
    cur = home
    for seg in ([] if rel == "." else rel.split(os.sep)):
        cur = os.path.join(cur, seg)
        try:
            st = os.lstat(cur)
        except FileNotFoundError:
            return None
        except OSError as e:
            return "无法检查 %s：%s" % (cur, e)
        if stat.S_ISLNK(st.st_mode):
            return "%s 是符号链接，门户拒绝在软链上读写" % cur
    return None


def _open_user_file(username, path, flags=os.O_RDONLY):
    """在用户家目录内安全打开一个普通文件，返回 (fd, err)。"""
    err = _link_free_chain(username, path)
    if err:
        return None, err
    try:
        st = os.lstat(path)
    except OSError as e:
        return None, "读取失败：%s" % e
    if not stat.S_ISREG(st.st_mode):
        return None, "不是普通文件，拒绝访问"
    uid = _uid_of(username)
    if uid is not None and st.st_uid not in (uid, 0):
        return None, "文件属主异常（uid=%s），拒绝访问" % st.st_uid
    try:
        return os.open(path, flags | os.O_NOFOLLOW), None
    except OSError as e:
        return None, "打开失败：%s" % e


def _ensure_user_dir(username, uid, path, mode):
    """在用户家目录内创建/校正一个目录（拒绝软链）。"""
    err = _link_free_chain(username, path)
    if err:
        die("初始化目录失败：%s" % err)
    if os.path.lexists(path):
        st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode):
            die("初始化目录失败：%s 已存在但不是目录（疑似符号链接）" % path)
    else:
        os.mkdir(path, mode)
    os.chown(path, int(uid), int(uid))
    os.chmod(path, mode)


def _ensure_dir_outside_home(path, uid, gid, mode):
    """在 root 拥有的目录树里（如 /share/images/<user>）创建/校正子目录，拒绝软链。"""
    if os.path.islink(path):
        die("%s 是符号链接，拒绝使用" % path)
    if os.path.lexists(path):
        st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode):
            die("%s 已存在但不是目录" % path)
    else:
        os.mkdir(path, mode)
    os.chown(path, int(uid), int(gid))
    os.chmod(path, mode)


def _check_regular_outside_home(path, allowed_uids):
    """校验 /share/images 下的普通文件（拒绝软链、非普通文件、属主异常）。"""
    real = os.path.realpath(path)
    root = os.path.realpath(IMAGES_ROOT)
    if not real.startswith(root.rstrip("/") + os.sep):
        return "镜像路径越界：%s" % real
    try:
        st = os.lstat(real)
    except OSError:
        return "镜像不存在：%s" % path
    if not stat.S_ISREG(st.st_mode):
        return "镜像必须是普通文件（拒绝软链/设备/目录）：%s" % path
    if st.st_uid not in allowed_uids:
        return "镜像属主异常（uid=%s）：%s" % (st.st_uid, path)
    return None


def valid_user(u):
    """账号语义校验：格式合法 **且** 不是系统/保留账号。

    用于一切"以该账号身份执行 / 写它的文件 / 注销它 / 提交它的作业"的命令。
    """
    return bool(USER_RE.match(u or "")) and not is_reserved(u)


def name_ok(u):
    """仅格式校验，**不排除**系统/保留账号。

    只允许用于「纯读取、且不以该账号身份执行」的命令：
        user-status（探测账号是否存在，_os_ok 需要）
        quota / quota-all
        slurm-info
    其它一切命令（submit / kill / job-state / log / rm-log / get-keys / set-keys /
    images / save-image / ensure-assoc / provision / unprovision / init）必须用
    valid_user()，否则门户就能以 root、portal 等账号的身份做事（写它的 authorized_keys、
    挂载它的家目录跑容器、注销它）。"""
    return bool(USER_RE.match(u or ""))


def reserved_guard(u):
    """建号/注销类命令的保护：保留用户名（root/portal 等）一律拒绝。"""
    return is_reserved(u)


def node_hostname():
    return sh_out(["hostname", "-s"])


def is_management_node():
    """/share 是本地文件系统 => 本机就是管理节点。

    与 cluster-admin/add-user.sh 的角色判定同一套口径（findmnt，不写死主机名）。
    注意：这里以前写的是 `node_hostname() != "admin"` —— "admin" 是老集群的主机名，
    换到新站点后该条件恒为真，导致「改配额」（portal-ctl set-quota）**全线失效**，
    门户上的「改配额」按钮也一直报"配额只能在 admin 节点设置"。
    """
    fstype = sh_out(["findmnt", "-no", "FSTYPE", "/share"], timeout=15)
    return bool(fstype) and fstype not in ("nfs", "nfs4")


def compute_nodes():
    """管理节点上可用的计算节点名（含管理节点自身），按 sinfo 分区实际输出。"""
    out_txt = sh_out(["sinfo", "-h", "-N", "-o", "%N"], timeout=30)
    return [x for x in out_txt.split() if x] or [node_hostname()]


def partition_name():
    p = sh_out(["sinfo", "-h", "-o", "%P"], timeout=30)
    return (p.split()[0] if p else "gpu").rstrip("*")


def nodes_ips(names=None):
    """节点名 -> IP（通用实现，不依赖固定节点名单）。

    以 /etc/hosts 为准：同一名字出现多次时**非回环地址优先、取最后一条**
    （与本手册"127.0.1.1 本机名 在前、真实 IP 在后"的写法一致）；
    回环地址仅在确实没有真实地址时采用。文件里没有的节点用 getent 兜底。
    因此加节点 / 改节点名都不需要改代码。
    """
    wanted = set(names) if names else None
    seen = {}
    try:
        with open("/etc/hosts", "r", encoding="utf-8") as fh:
            for ln in fh:
                parts = ln.split("#")[0].split()
                if len(parts) < 2:
                    continue
                ip = parts[0]
                for name in parts[1:]:
                    if wanted is not None and name not in wanted:
                        continue
                    seen.setdefault(name, []).append(ip)
    except OSError:
        pass
    ips = {}
    for name, cand in seen.items():
        real = [c for c in cand if not c.startswith("127.")]
        ips[name] = (real or cand)[-1]
    for name in (wanted or []):
        if name in ips:
            continue
        r = run(["getent", "ahostsv4", name], timeout=15)
        cand = [l.split()[0] for l in r.stdout.splitlines() if l.split()]
        real = [c for c in cand if not c.startswith("127.")]
        if real or cand:
            ips[name] = (real or cand)[0]
    return ips


def _shq(s):
    """把单个参数安全地变成远端 shell 的一个词（POSIX 单引号转义）。"""
    return "'" + str(s).replace("'", "'\"'\"'") + "'"


def ssh_node(node, argv, timeout=60):
    """在计算节点上以 root 执行 argv（本机直接执行）。

    注意：ssh 会把 host 之后的 argv **用空格拼成一个字符串**交给远端登录 shell，
    引号会丢失。历史写法 `["bash", "-c", "ss ... | grep ..."]` 因此被远端重新解析。
    这里统一把每个参数做单引号转义后再拼，保证语义与本地执行一致（也堵住
    "参数里带空格/元字符 → 远端被当代码执行" 的隐患）。
    """
    if node == node_hostname():
        return run(argv, timeout=timeout)
    remote = " ".join(_shq(a) for a in argv)
    return run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                "-o", "StrictHostKeyChecking=accept-new", "-p", SSH_PORT,
                "root@" + node, remote], timeout=timeout)


# ----------------------------------------------------------------------------
# ping / sinfo
# ----------------------------------------------------------------------------
def cmd_ping():
    out({"ok": True, "whoami": sh_out(["id", "-un"]), "host": node_hostname()})


def cmd_sinfo():
    part = partition_name()
    raw = sh_out(["sinfo", "-h", "-p", part, "-N", "-o", "%N|%T|%C|%G|%m|%a"],
                 timeout=30)
    fields = [ln.strip().split("|") for ln in raw.splitlines()]
    fields = [f for f in fields if len(f) >= 6]
    ips = nodes_ips([f[0] for f in fields])
    nodes = []
    for f in fields:
        name, state, cpus, gres, mem_mb, avail = f[0], f[1], f[2], f[3], f[4], f[5]
        ca = ci = co = ct = 0
        m = re.match(r"^(\d+)/(\d+)/(\d+)/(\d+)$", cpus)
        if m:
            ca, ci, co, ct = (int(x) for x in m.groups())
        try:
            mem = int(mem_mb)
        except ValueError:
            mem = 0
        nodes.append({
            "name": name, "state": state, "avail": avail,
            "cpus_alloc": ca, "cpus_idle": ci, "cpus_other": co, "cpus_total": ct,
            "mem_mb": mem, "gres": gres,
            "ip": ips.get(name, ""),
        })
    out({"ok": True, "partition": part, "nodes": nodes})



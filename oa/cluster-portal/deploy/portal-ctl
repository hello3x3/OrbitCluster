# 用户名规则：小写字母/数字/下划线，且以字母或下划线开头（= Linux 账号名）。
# 与 portalapp/app.py 的 USERNAME_RE 必须保持一致：门户能建出来的名字，
# 这里的 valid_user()/name_ok() 就必须认，否则账号建出来却每条命令都被判"非法用户名"。
USER_RE = re.compile(r"^[a-z_][a-z0-9_]{0,31}$")
# 账户名规则（契约 §0/§3）：小写字母开头，仅小写字母/数字/下划线/横线，最长 32 位。
# 与 portalapp/db.py / app.py 两端的校验必须一字不差 —— 否则门户建得出、助手不认（或反之）。
ACCOUNT_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
# 每个账户对应一个 QoS：acct-<账户名>。账户的优先级/每用户卡数上限/抢占都挂在这个 QoS 上。
ACCOUNT_QOS_PREFIX = "acct-"
QOS_PRIORITY_MIN, QOS_PRIORITY_MAX = 1, 10
GPU_CAP_MAX = 64
QUOTA_RE = re.compile(r"^[1-9][0-9]{0,2}[GgTtMm]$")
# 「不限配额」的规范写法；另接受 0 / UNLIMITED 作为输入别名
QUOTA_UNLIMITED = "不限"
_QUOTA_UNLIMITED_RE = re.compile(r"^(?:不限|0|UNLIMITED)$", re.IGNORECASE)


def quota_valid(size):
    """额度是否合法：'100G' / '1T' / '200M' 之类，或「不限」。"""
    s = (size or "").strip()
    return bool(QUOTA_RE.match(s) or _QUOTA_UNLIMITED_RE.match(s))

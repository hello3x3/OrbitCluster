                die("用法: provision-user <用户名> <配额> [--skip-os] [--uid N] "
                    "[--accounts a,b] [--default-account x]")
            rest = sys.argv[4:]
            uid_opt = None
            skip_os = False
            acct_rest = []
            i = 0
            while i < len(rest):
                a = rest[i]
                if a == "--uid":

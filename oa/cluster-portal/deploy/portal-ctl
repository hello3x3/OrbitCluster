def _quota_rows():
    """repquota CSV -> {user: {used_kb, soft_kb, hard_kb, files_used, ...}}"""
    import csv
    import io
    r = run(["repquota", "-u", "/share", "-O", "csv"], timeout=60)
    if r.returncode != 0:
        return {}
    out = {}
    for row in csv.DictReader(io.StringIO(r.stdout)):
        u = (row.get("User") or "").strip()
        if not u:
            continue
        try:
            out[u] = {
                "used_kb": int(float(row.get("BlockUsed") or 0)),
                "soft_kb": int(float(row.get("BlockSoftLimit") or 0)),
                "hard_kb": int(float(row.get("BlockHardLimit") or 0)),
                "files_used": int(float(row.get("FileUsed") or 0)),
                "files_soft": int(float(row.get("FileSoftLimit") or 0)),
                "files_hard": int(float(row.get("FileHardLimit") or 0)),
            }
        except (TypeError, ValueError):
            continue
    return out


def cmd_quota(username):
    """单个用户的 /share 实际配额（无配额记录=不限）。"""
    if not name_ok(username):
        die("非法用户名")
    if run(["id", "-u", username]).returncode != 0:
        die("OS 账号 %s 不存在，无法读取配额" % username)
    row = _quota_rows().get(username)
    if not row:
        out({"ok": True, "username": username, "exists": True,
             "used_kb": 0, "soft_kb": 0, "hard_kb": 0,
             "files_used": 0, "files_soft": 0, "files_hard": 0,
             "note": "该账号无配额记录（视为不限）"})
    row["ok"] = True
    row["username"] = username
    row["exists"] = True
    out(row)


def cmd_quota_all():
    rows = _quota_rows()
    out({"ok": True, "quotas": rows})


def cmd_set_quota(username, size):
    """设置 /share 配额（软=硬）。校验后调用 /opt/cluster-admin/set-quota.sh。"""
    if not USER_RE.match(username or ""):
        die("非法用户名")
    if run(["id", "-u", username]).returncode != 0:
        die("OS 账号 %s 不存在" % username)
    if not quota_valid(size):
        die("配额格式错误: %s（例 100G / 500G / 1T，或「不限」）" % size)
    # 保留账号（root/slurm/nobody 等）不允许设**具体额度**，但允许设「不限」——
    # 那是清除限额，也是把库里遗留的具体值（如 root 的建号默认 500G）与 OS 现状对齐的途径
    if is_reserved(username) and not _QUOTA_UNLIMITED_RE.match((size or "").strip()):
        die("系统/保留账号不能设置具体配额（可设为「不限」清除限额）")
    if not os.path.isfile(os.path.join(CLUSTER_ADMIN_DIR, "set-quota.sh")):
        die("缺少 %s/set-quota.sh" % CLUSTER_ADMIN_DIR)
    # 仅管理节点可设：/share 必须是本地文件系统（计算节点上 /share 是 NFS，
    # setquota 无意义）。set-quota.sh 内部也会按 findmnt 再判一次。
    if not is_management_node():
        die("配额只能在管理节点设置：本机 /share 不是本地文件系统"
            "（管理节点 = /share 为本地盘的那台）")
    r = run(["bash", os.path.join(CLUSTER_ADMIN_DIR, "set-quota.sh"), username, size],
            timeout=90)
    if r.returncode != 0:
        die("set-quota 失败: %s" % (r.stderr.strip()[-300:] or r.stdout.strip()[-300:]))
    row = _quota_rows().get(username) or {}
    out({"ok": True, "username": username, "requested": size,
         "used_kb": row.get("used_kb", 0), "soft_kb": row.get("soft_kb", 0),
         "hard_kb": row.get("hard_kb", 0)})


# ----------------------------------------------------------------------------
# 多账户：Slurm account + 每账户 QoS `acct-<name>`（契约 §2/§3）
#
# 模型：
#   account <name>      sacctmgr add account <name> Organization=<cluster> Description=...
#   QoS acct-<name>     Priority=<1..10>、MaxTRESPerUser=gres/gpu=<n>（0/缺省=不限）
#                       **绝不设置账户级 GrpTRES**：多账户额度允许叠加，不做全局单用户拦截
#   成员关联            sacctmgr add user <u> account=<a> qos=acct-<a> defaultqos=acct-<a>
#                       用户的 DefaultAccount 用 modify user set 单独设置
#   preempt=true        QoS Preempt = 其它优先级更低的 acct-* QoS 列表（helper 全量重算）
# 所有写操作以 sacctmgr 返回码为准：失败即 die（fail closed，不静默吞错）。
# ----------------------------------------------------------------------------

def valid_account(name):
    """账户名是否合法（与门户 DB/路由两端共用同一条正则）。"""
    return bool(ACCOUNT_RE.match(name or ""))


def acct_qos(name):
    """账户 -> 对应的 QoS 名（约定 acct-<账户名>，不额外存映射）。"""
    return ACCOUNT_QOS_PREFIX + name


def site_accounts():
    """site.conf 里的账户列表：ACCOUNTS 优先，缺省回退 ACCOUNT，去重保序。"""
    items = []
    raw = (SITE.get("ACCOUNTS") or "").strip()
    if raw:
        for x in re.split(r"[,\s]+", raw):
            x = x.strip()
            if x and x not in items:
                items.append(x)
    if not items:
        a = (SITE.get("ACCOUNT") or "").strip()
        if a:
            items = [a]
    return items


def site_default_account():
    """site.conf 的默认账户：DEFAULT_ACCOUNT 优先，缺省取第一个账户。"""
    d = (SITE.get("DEFAULT_ACCOUNT") or "").strip()
    if d:
        return d
    a = site_accounts()
    return a[0] if a else ""


def _cluster_org():
    """sacctmgr 的 Organization 字段值：优先站点集群名。"""
    for k in ("CLUSTER_NAME", "CLUSTER"):
        v = (SITE.get(k) or "").strip()
        if v:
            return v
    return "cluster"


def _sacct_show(argv):
    return run(["sacctmgr", "-n", "-P"] + list(argv), timeout=45)


def _accounts_in_slurm():
    """Slurm 里已存在的账户 -> Description；查询失败返回 None（调用方 fail closed）。"""
    r = _sacct_show(["show", "account", "format=Account,Description"])
    if r.returncode != 0:
        return None
    got = {}
    for ln in (r.stdout or "").splitlines():
        if not ln.strip():
            continue
        f = ln.split("|", 1)
        name = f[0].strip()
        if name:
            got[name] = f[1].strip() if len(f) > 1 else ""
    return got


def _gpu_cap_from_tres(raw):
    """从 `gres/gpu=8`（可能混有其它 TRES）解析每用户卡数上限；无法解析/0 = 不限。"""
    for item in re.split(r"[,;]", raw or ""):
        m = re.match(r"\s*gres/gpu=(\d+)\s*$", item, re.IGNORECASE)
        if m:
            try:
                return int(m.group(1))
            except ValueError:
                return 0
    return 0


def _qos_map():
    """acct-* QoS -> {priority:int, max_tres_per_user:str, per_user_gpu_cap:int, preempt:str}。

    查询失败返回 None（调用方 fail closed）。注意 sacctmgr 的格式字段名是 **MaxTRESPU**
    （设置时才是 MaxTRESPerUser），别写反 —— 写反会直接查询失败。
    """
    r = _sacct_show(["show", "qos", "format=Name,Priority,MaxTRESPU,Preempt"])
    if r.returncode != 0:
        return None
    got = {}
    for ln in (r.stdout or "").splitlines():
        f = ln.split("|")
        if not f or not f[0].strip():
            continue
        name = f[0].strip()
        if not name.startswith(ACCOUNT_QOS_PREFIX):
            continue
        acct = name[len(ACCOUNT_QOS_PREFIX):]
        if not valid_account(acct):
            continue          # 不是本门户的账户 QoS（例如手工建的非法名）
        prio = 0
        if len(f) > 1 and f[1].strip().isdigit():
            prio = int(f[1].strip())
        maxtres = f[2].strip() if len(f) > 2 else ""
        preempt = f[3].strip() if len(f) > 3 else ""
        got[name] = {"priority": prio, "max_tres_per_user": maxtres,
                     "per_user_gpu_cap": _gpu_cap_from_tres(maxtres),
                     "preempt": preempt}
    return got


def _user_defaults():
    """用户名 -> DefaultAccount；查询失败返回 None。"""
    r = _sacct_show(["show", "user", "format=Name,DefaultAccount"])
    if r.returncode != 0:
        return None
    got = {}
    for ln in (r.stdout or "").splitlines():
        f = ln.split("|")
        if f and f[0].strip():
            got[f[0].strip()] = f[1].strip() if len(f) > 1 else ""
    return got


def _user_account_names(username):
    """该用户实际关联的账户名列表（去重保序）；查询失败返回 None。"""
    r = _sacct_show(["show", "assoc", "user=%s" % username, "format=Account"])
    if r.returncode != 0:
        return None
    names = []
    for ln in (r.stdout or "").splitlines():
        f = ln.split("|")
        if not f:
            continue
        for a in f[0].split(","):
            a = a.strip()
            if a and a not in names:
                names.append(a)
    return names


def _account_user_rows(name):
    """账户成员 -> [{username, qos}]（按用户名去重保序）；查询失败返回 None。"""
    r = _sacct_show(["show", "assoc", "account=%s" % name, "format=User,QOS"])
    if r.returncode != 0:
        return None
    rows = []
    seen = {}
    for ln in (r.stdout or "").splitlines():
        f = ln.split("|")
        if not f:
            continue
        u = f[0].strip()
        if not u:
            continue
        q = f[1].strip() if len(f) > 1 else ""
        q = q.split(",")[0].strip() if q else ""
        if u in seen:
            if q and not seen[u]["qos"]:
                seen[u]["qos"] = q
            continue
        rec = {"username": u, "qos": q}
        seen[u] = rec
        rows.append(rec)
    return rows


def _create_account(name):
    """在 Slurm 会计里创建账户；返回 (ok, err)。"""
    r = run(["sacctmgr", "-i", "add", "account", name,
             "Organization=%s" % _cluster_org(),
             "Description=portal account %s" % name], timeout=60)
    if r.returncode == 0:
        return True, ""
    accts = _accounts_in_slurm()
    if accts is not None and name in accts:
        return True, ""          # 并发/重复创建：已存在即视为成功
    return False, "创建账户 %s 失败: %s" % (name, (r.stderr or r.stdout or "").strip()[:300])


def _create_qos(name, priority=5):
    """创建 acct-<name> QoS（已存在则视为成功；不修改已有 QoS 的参数）。"""
    qos = acct_qos(name)
    r = run(["sacctmgr", "-i", "add", "qos", qos, "Priority=%d" % int(priority)],
            timeout=60)
    if r.returncode == 0:
        return True, ""
    qmap = _qos_map()
    if qmap is not None and qos in qmap:
        return True, ""
    return False, "创建 QoS %s 失败: %s" % (qos, (r.stderr or r.stdout or "").strip()[:300])


def _account_ensure(name):
    """确保账户 + acct-<name> QoS 存在（缺失才建；默认 priority=5、不限卡）。

    已存在的账户/QoS **不覆盖**其参数 —— 优先级/卡数上限的同步由 accounts-sync 负责。
    用户开通路径用它做懒创建：这样首次部署即使还没跑过 accounts-init 也不会卡住建号。
    """
    if not valid_account(name):
        return False, "非法账户名: %s" % name
    accts = _accounts_in_slurm()
    if accts is None:
        return False, "查询 Slurm 账户失败（slurmdbd 未运行或无权限？）"
    if name not in accts:
        ok, err = _create_account(name)
        if not ok:
            return False, err
    qmap = _qos_map()
    if qmap is None:
        return False, "查询 Slurm QoS 失败（slurmdbd 未运行或无权限？）"
    if acct_qos(name) not in qmap:
        ok, err = _create_qos(name)
        if not ok:
            return False, err
    return True, ""


def _qos_apply(name, priority, cap, preempt=None):
    """设置 acct-<name> QoS：Priority、MaxTRESPerUser、Preempt（None=不改 Preempt）。

    cap<=0 表示“不限/清除限额”。返回 (ok, err)。
    """
    qos = acct_qos(name)
    try:
        priority = int(priority)
        cap = int(cap)
    except (TypeError, ValueError):
        return False, "QoS %s 的优先级/卡数上限必须是整数" % qos
    if not (QOS_PRIORITY_MIN <= priority <= QOS_PRIORITY_MAX):
        return False, "QoS %s 的 Priority 必须在 %d-%d（收到 %s）" % (
            qos, QOS_PRIORITY_MIN, QOS_PRIORITY_MAX, priority)
    specs = ["Priority=%d" % priority]
    if cap > 0:
        specs.append("MaxTRESPerUser=gres/gpu=%d" % cap)
    else:
        specs.append("MaxTRESPerUser=")
    if preempt is not None:
        specs.append("Preempt=%s" % (",".join(preempt) if preempt else ""))
    r = run(["sacctmgr", "-i", "modify", "qos", qos, "set"] + specs, timeout=60)
    if r.returncode != 0 and cap <= 0:
        # Slurm 文档约定：清除 TRES 限额用 -1（空值/0 在不同版本里语义不一致）
        specs2 = [s for s in specs if not s.startswith("MaxTRESPerUser=")]
        specs2.append("MaxTRESPerUser=gres/gpu=-1")
        r = run(["sacctmgr", "-i", "modify", "qos", qos, "set"] + specs2, timeout=60)
    if r.returncode != 0:
        return False, "设置 QoS %s 失败: %s" % (
            qos, (r.stderr or r.stdout or "").strip()[:300])
    return True, ""


def _ensure_account_assoc(username, name):
    """确保用户与账户的关联存在（qos/defaultqos=acct-<name>）；返回 (ok, err)。"""
    ok, err = _account_ensure(name)
    if not ok:
        return False, err
    names = _user_account_names(username)
    if names is None:
        return False, "查询 %s 的会计关联失败（sacctmgr 不可用？）" % username
    if name in names:
        return True, ""
    return _add_user_assoc(username, name)


def _add_user_assoc(username, name):
    """为用户建立到账户的成员关联（qos/defaultqos=acct-<name>）；返回 (ok, err)。

    sacctmgr 不同版本对字段别名的接受度略有差异：先按契约写法（account=/qos=/defaultqos=），
    失败再按 sacctmgr 帮助里的规范写法（Accounts=/QosLevel=/DefaultQOS=）。
    两种都失败才报错 —— 但只要复查发现关联已存在，就按幂等成功处理。
    """
    qos = acct_qos(name)
    last = ""
    for extra in (["account=%s" % name, "qos=%s" % qos, "defaultqos=%s" % qos],
                  ["Accounts=%s" % name, "QosLevel=%s" % qos, "DefaultQOS=%s" % qos]):
        r = run(["sacctmgr", "-i", "add", "user", username] + extra, timeout=60)
        if r.returncode == 0:
            return True, ""
        last = (r.stderr or r.stdout or "").strip()[:300]
        names = _user_account_names(username)
        if names is not None and name in names:
            return True, ""          # 并发/重复调用：已存在即幂等成功
    return False, "建立 %s -> %s 的会计关联失败: %s" % (username, name, last)


def _remove_user_assoc(username, name):
    """删除用户与账户的成员关联（只删这一条，不动用户的其它账户）；返回 (ok, err)。"""
    last = ""
    for extra in (["Names=%s" % username, "Accounts=%s" % name],
                  [username, "account=%s" % name],
                  ["name=%s" % username, "account=%s" % name]):
        r = run(["sacctmgr", "-i", "delete", "user"] + extra, timeout=60)
        if r.returncode == 0:
            return True, ""
        last = (r.stderr or r.stdout or "").strip()[:300]
        names = _user_account_names(username)
        if names is not None and name not in names:
            return True, ""
    return False, "把 %s 移出账户 %s 失败: %s" % (username, name, last)


def _set_default_account(username, name):
    """设置用户的默认账户（DefaultAccount）；返回 (ok, err)。"""
    r = run(["sacctmgr", "-i", "modify", "user", username,
             "set", "DefaultAccount=%s" % name], timeout=60)
    if r.returncode != 0:
        # 旧版本需要 where 子句限定是哪条关联（帮助里的 where 字段名是 Accounts=）
        r = run(["sacctmgr", "-i", "modify", "user", username,
                 "where", "Accounts=%s" % name,
                 "set", "DefaultAccount=%s" % name], timeout=60)
    if r.returncode != 0:
        return False, "设置默认账户 %s 失败: %s" % (
            name, (r.stderr or r.stdout or "").strip()[:300])
    defaults = _user_defaults()
    if defaults is not None and defaults.get(username):
        if defaults.get(username) != name:
            return False, "默认账户设置未生效：期望 %s，实际 %s" % (
                name, defaults.get(username))
    return True, ""


def _resolve_accounts(accounts, default_account):
    """规范化命令行账户参数。

    accounts=None 表示**没传** → 按旧行为用 site.conf 的默认账户单个；
    accounts=[]   表示**显式空列表**（管理员角色允许不选账户）→ 不做任何关联。
    返回 (names, default, err)。
    """
    if accounts is None:
        d = site_default_account()
        if not d:
            return [], "", ("site.conf 未配置 DEFAULT_ACCOUNT / ACCOUNT，无法确定账户；"
                            "请显式传 --accounts")
        if not valid_account(d):
            return [], "", "site.conf 的默认账户名非法: %s" % d
        return [d], d, ""
    names = []
    for a in accounts:
        a = (a or "").strip()
        if not a or a in names:
            continue
        if not valid_account(a):
            return [], "", "非法账户名: %s（须匹配 %s）" % (a, ACCOUNT_RE.pattern)
        names.append(a)
    d = (default_account or "").strip()
    if not names:
        if d:
            return [], "", "指定了默认账户 %s，但账户列表为空" % d
        return [], "", ""
    if not d:
        d = names[0]
    if not valid_account(d):
        return [], "", "非法默认账户名: %s" % d
    if d not in names:
        return [], "", "默认账户 %s 不在账户列表 %s 中" % (d, ",".join(names))
    return names, d, ""


def _ensure_assocs(username, accounts=None, default_account=None, set_default=True):
    """确保用户与给定账户列表的关联；返回 (ok, err, ensured_names)。

    绝不把用户加入参数里没列出的账户（契约 §3.2）。set_default=False 用于 submit
    的旧行为兜底：只补关联，不改用户的默认账户。
    """
    names, default, err = _resolve_accounts(accounts, default_account)
    if err:
        return False, err, []
    existing = _user_account_names(username)
    if existing is None:
        return False, "查询 %s 的会计关联失败（sacctmgr 不可用？）" % username
    for a in names:
        ok, e = _account_ensure(a)
        if not ok:
            return False, e, []
        if a in existing:
            continue
        ok, e = _add_user_assoc(username, a)
        if not ok:
            return False, e, []
        existing.append(a)
    if set_default and default:
        ok, e = _set_default_account(username, default)
        if not ok:
            return False, e, []
    return True, "", names


def _ensure_assoc(username):
    """兼容旧调用：确保关联到 site.conf 默认账户并设默认账户。返回 (ok, err)。"""
    ok, err, _ = _ensure_assocs(username, None, None)
    return ok, err


def _user_accounts_info(username):
    """用户实际关联的账户（供 user-accounts / slurm-info 共用）。

    返回 (default_account, accounts, err)；accounts 每项：
      {"name","qos","priority","per_user_gpu_cap","is_default","preempt"}
    """
    names = _user_account_names(username)
    if names is None:
        return "", [], "查询 %s 的会计关联失败（sacctmgr 不可用？）" % username
    defaults = _user_defaults()
    if defaults is None:
        return "", [], "查询用户默认账户失败（sacctmgr 不可用？）"
    qmap = _qos_map()
    if qmap is None:
        return "", [], "查询 Slurm QoS 失败（sacctmgr 不可用？）"
    default = defaults.get(username, "")
    accounts = []
    for n in names:
        q = acct_qos(n)
        qi = qmap.get(q, {})
        accounts.append({
            "name": n, "qos": q,
            "priority": int(qi.get("priority", 0)),
            "per_user_gpu_cap": int(qi.get("per_user_gpu_cap", 0)),
            "is_default": n == default,
            "preempt": qi.get("preempt", ""),
        })
    accounts.sort(key=lambda a: (not a["is_default"], a["name"]))
    return default, accounts, ""


# ----------------------------------------------------------------------------
# 账户命令（契约 §3.1）
# ----------------------------------------------------------------------------
def cmd_accounts():
    """全部账户（站点配置 + Slurm 已存在）+ acct-* QoS 参数 + 成员数。"""
    accts = _accounts_in_slurm()
    if accts is None:
        die("查询 Slurm 账户失败（slurmdbd 未运行或无权限？）")
    qmap = _qos_map()
    if qmap is None:
        die("查询 Slurm QoS 失败（slurmdbd 未运行或无权限？）")
    r = _sacct_show(["show", "assoc", "format=Account,User"])
    if r.returncode != 0:
        die("查询账户成员失败: %s" % (r.stderr or r.stdout or "").strip()[:300])
    members = {}
    for ln in (r.stdout or "").splitlines():
        f = ln.split("|")
        acct = f[0].strip() if f else ""
        user = f[1].strip() if len(f) > 1 else ""
        if acct and user:
            members.setdefault(acct, set()).add(user)
    names = []
    for n in site_accounts() + sorted(accts):
        if n and n not in names:
            names.append(n)
    rows = []
    for n in names:
        q = acct_qos(n)
        qi = qmap.get(q, {})
        rows.append({
            "name": n, "qos": q, "exists": n in accts,
            "priority": int(qi.get("priority", 0)),
            "per_user_gpu_cap": int(qi.get("per_user_gpu_cap", 0)),
            "preempt": qi.get("preempt", ""),
            "members": len(members.get(n, ())),
        })
    out({"ok": True, "accounts": rows})


def cmd_accounts_init():
    """按 site.conf 的 ACCOUNTS 幂等创建账户与 acct-* QoS（priority=5、卡数不限）。"""
    names = site_accounts()
    if not names:
        die("site.conf 未配置 ACCOUNTS / ACCOUNT，无法初始化账户")
    for n in names:
        if not valid_account(n):
            die("site.conf 里的账户名非法: %s（须匹配 %s）" % (n, ACCOUNT_RE.pattern))
    accts = _accounts_in_slurm()
    if accts is None:
        die("查询 Slurm 账户失败（slurmdbd 未运行或无权限？）")
    qmap = _qos_map()
    if qmap is None:
        die("查询 Slurm QoS 失败（slurmdbd 未运行或无权限？）")
    created, existing = [], []
    for n in names:
        if n in accts:
            existing.append(n)
        else:
            ok, err = _create_account(n)
            if not ok:
                die(err)
            created.append(n)
        if acct_qos(n) not in qmap:
            ok, err = _create_qos(n, priority=5)
            if not ok:
                die(err)
    out({"ok": True, "created": created, "existing": existing})


def cmd_accounts_sync():
    """stdin JSON: {"accounts":[{"name","priority","per_user_gpu_cap","preempt"},...]}

    只创建/更新，**不删除**账户；最后对**所有** acct-* QoS 全量重算 Preempt。
    """
    try:
        payload = json.load(sys.stdin)
    except Exception:
        die("stdin 不是合法 JSON")
    if not isinstance(payload, dict) or not isinstance(payload.get("accounts"), list):
        die('输入必须是 {"accounts": [...]}')
    items = []
    seen = set()
    for it in payload["accounts"]:
        if not isinstance(it, dict):
            die("accounts 的每一项必须是对象")
        name = str(it.get("name", "")).strip()
        if not valid_account(name):
            die("非法账户名: %s（须匹配 %s）" % (name, ACCOUNT_RE.pattern))
        if name in seen:
            die("accounts 列表存在重复账户名: %s" % name)
        seen.add(name)
        try:
            priority = int(it.get("priority", 5))
            cap = int(it.get("per_user_gpu_cap", 0))
        except (TypeError, ValueError):
            die("账户 %s 的 priority / per_user_gpu_cap 必须是整数" % name)
        if not (QOS_PRIORITY_MIN <= priority <= QOS_PRIORITY_MAX):
            die("账户 %s 的 priority 必须在 %d-%d（收到 %d）"
                % (name, QOS_PRIORITY_MIN, QOS_PRIORITY_MAX, priority))
        if not (0 <= cap <= GPU_CAP_MAX):
            die("账户 %s 的 per_user_gpu_cap 必须在 0-%d（0=不限，收到 %d）"
                % (name, GPU_CAP_MAX, cap))
        items.append({"name": name, "priority": priority, "cap": cap,
                      "preempt": bool(it.get("preempt", False))})
    # 1) 确保账户 + QoS 都存在（缺失的懒创建，已存在的不动参数）
    for it in items:
        ok, err = _account_ensure(it["name"])
        if not ok:
            die(err)
    # 2) 重新读取权威状态，算出每个 acct-* QoS 的最终参数
    qmap = _qos_map()
    if qmap is None:
        die("查询 Slurm QoS 失败（slurmdbd 未运行或无权限？）")
    desired = {}
    for q, qi in qmap.items():
        desired[q] = {"priority": int(qi.get("priority", 0)),
                      "cap": int(qi.get("per_user_gpu_cap", 0))}
    preempt_on = set()
    for it in items:
        q = acct_qos(it["name"])
        desired[q] = {"priority": it["priority"], "cap": it["cap"]}
        if it["preempt"]:
            preempt_on.add(q)
    # 3) 全量重算 Preempt：= 所有优先级更低的其它 acct-* QoS（同级不算）
    qos_names = sorted(desired)
    for q in qos_names:
        priority = desired[q]["priority"]
        lower = [x for x in qos_names
                 if x != q and desired[x]["priority"] < priority]
        preempt = lower if q in preempt_on else []
        ok, err = _qos_apply(q[len(ACCOUNT_QOS_PREFIX):], priority,
                             desired[q]["cap"], preempt)
        if not ok:
            die(err)
    out({"ok": True, "synced": [it["name"] for it in items]})


def cmd_account_delete(name):
    """删除账户（有成员或运行/排队作业时拒绝；同时删掉 acct-<name> QoS）。"""
    if not valid_account(name):
        die("非法账户名: %s（须匹配 %s）" % (name, ACCOUNT_RE.pattern))
    d = site_default_account()
    if d and name == d:
        die("拒绝删除站点默认账户 %s（site.conf DEFAULT_ACCOUNT）" % name)
    accts = _accounts_in_slurm()
    if accts is None:
        die("查询 Slurm 账户失败（slurmdbd 未运行或无权限？）")
    qmap = _qos_map()
    if qmap is None:
        die("查询 Slurm QoS 失败（slurmdbd 未运行或无权限？）")
    qos = acct_qos(name)
    if name not in accts:
        # 幂等：账户已不存在；仍尝试清理可能残留的 QoS（失败要报出来，不静默）
        if qos in qmap:
            r = run(["sacctmgr", "-i", "delete", "qos", qos], timeout=60)
            if r.returncode != 0:
                die("账户 %s 已不存在，但残留 QoS %s 删除失败: %s（请手动 sacctmgr delete qos %s）"
                    % (name, qos, (r.stderr or r.stdout or "").strip()[:300], qos))
        out({"ok": True, "deleted": name, "existed": False})
        return
    rows = _account_user_rows(name)
    if rows is None:
        die("查询账户 %s 的成员失败（sacctmgr 不可用？）" % name)
    if rows:
        die("账户 %s 还有 %d 个成员（%s），请先把成员移出该账户再删除"
            % (name, len(rows), "、".join(r["username"] for r in rows[:10])))
    r = run(["squeue", "-h", "-a", "-o", "%A|%a"], timeout=30)
    if r.returncode != 0:
        die("查询运行/排队作业失败，拒绝删除账户（fail closed）: %s"
            % (r.stderr or r.stdout or "").strip()[:300])
    active = []
    for ln in (r.stdout or "").splitlines():
        f = ln.split("|")
        if len(f) >= 2 and f[1].strip() == name:
            active.append(f[0].strip())
    if active:
        die("账户 %s 还有运行/排队作业（%s），请先停掉这些作业再删除"
            % (name, "、".join(active[:10])))
    r = run(["sacctmgr", "-i", "delete", "account", name], timeout=60)
    if r.returncode != 0:
        again = _accounts_in_slurm()
        if again is None or name in again:
            die("删除账户 %s 失败: %s" % (
                name, (r.stderr or r.stdout or "").strip()[:300]))
    if qos in qmap:
        r = run(["sacctmgr", "-i", "delete", "qos", qos], timeout=60)
        if r.returncode != 0:
            again = _qos_map()
            if again is None or qos in again:
                die("账户 %s 已删除，但 QoS %s 删除失败: %s（请手动 sacctmgr delete qos %s）"
                    % (name, qos, (r.stderr or r.stdout or "").strip()[:300], qos))
    out({"ok": True, "deleted": name, "existed": True})


def cmd_account_users(name):
    """账户成员列表（含是否为默认账户、关联 QoS）。"""
    if not valid_account(name):
        die("非法账户名: %s（须匹配 %s）" % (name, ACCOUNT_RE.pattern))
    accts = _accounts_in_slurm()
    if accts is None:
        die("查询 Slurm 账户失败（slurmdbd 未运行或无权限？）")
    if name not in accts:
        die("账户不存在: %s" % name)
    rows = _account_user_rows(name)
    if rows is None:

def _as_user_argv(username, home, argv):
    """以目标用户身份、在其家目录为 cwd 执行 argv（无 shell 拼接；env -C 处理 cwd）。"""
    return ["runuser", "-u", username, "--", "env", "-C", home] + list(argv)


def cmd_save_image(username, job_id, name, force):
    """把“运行中的容器”整体导出为个人镜像 /share/images/<username>/<name>.sqsh。

    - 容器须正在运行（作业属主须为该用户，state=RUNNING，实际节点从 squeue 现查）；
    - rootfs 即计算节点 ENROOT_DATA_PATH 下的 pyxis_<jobid>_portal（submit 时以
      --container-name=portal 创建）；enroot export 以该用户身份执行（写 NFS 到 admin 的
      /share，文件归用户所有 → 计入该用户磁盘配额）；
    - 用户名 root(uid 0) 从计算节点写 NFS 会被 root_squash，故先导出到节点本地再 scp 回 admin。
    """
    if not valid_user(username):
        die("非法用户名或系统保留账号: %s" % username)
    if not IMG_NAME_RE.match(name or ""):
        die("镜像名只能包含英文/数字/下划线（1-64 位），不含空格或特殊字符")
    try:
        job_id = int(job_id)
    except (TypeError, ValueError):
        die("非法 jobid")
    if job_id <= 0:
        die("非法 jobid")
    force = str(force) in ("1", "True", "true")

    sq = sh_out(["squeue", "-h", "-j", str(job_id), "-o", "%u|%T|%N"], timeout=30)
    if not sq:
        die("作业不存在或已结束：镜像只能在容器运行时保存")
    f = sq.split("|")
    if len(f) < 3:
        die("查询作业状态失败: %s" % sq)
    owner, state, node = f[0], f[1], f[2]
    if owner != username:
        die("作业 %d 属主为 %s，非 %s" % (job_id, owner, username))
    if state != "RUNNING":
        die("容器当前状态为 %s，仅运行中(RUNNING)可保存镜像" % state)

    host = node_hostname()
    if node not in compute_nodes():
        die("作业所在节点 %s 不在分区内" % node)
    uid = sh_out(["id", "-u", username], timeout=20)
    if not uid.isdigit():
        die("读取 %s UID 失败" % username)

    home, herr = checked_home(username)
    if herr:
        die(herr)
    tdir = os.path.join(IMAGES_ROOT, username)
    # 不用 install -d：改为显式拒绝软链后 mkdir/chown/chmod（/share/images 本身 root 755，
    # 正常不会被外人写，这里是纵深防御）
    _ensure_dir_outside_home(tdir, int(uid), int(uid), 0o700)
    target = os.path.join(tdir, name + ".sqsh")
    if os.path.exists(target) and not force:
        die("个人镜像已存在: %s（如需覆盖请重新提交并确认覆盖）" % target)

    container = "pyxis_%d_portal" % job_id
    export_argv = ["enroot", "export"] + (["-f"] if force else []) + \
                  ["-o", target, container]
    timeout = 3600
    import time as _time
    t0 = _time.time()
    # 收集导出过程的输出（尾部），供门户写进"门户操作日志"，失败时便于定位
    chunks = []

    if node == host:
        # 本机（admin）直接执行（真实 root 环境；uid=0 也无 root_squash 问题）
        r = run(_as_user_argv(username, home, export_argv), timeout=timeout)
        chunks.append((r.stdout or "") + (r.stderr or ""))
        if r.returncode != 0:
            _cleanup_partial(target)
            die("镜像导出失败: %s" % (r.stderr.strip()[-300:] or r.stdout.strip()[-300:]))
    elif uid == "0":
        # 用户名 root：计算节点写 NFS 被 root_squash，先导出到节点本地再 scp 回 admin
        local_tmp = "/scratch/.portal-save-%d-%s.sqsh" % (job_id, name)
        r0 = ssh_node(node, _as_user_argv(username, "/",
                                           ["enroot", "export", "-o", local_tmp, container]),
                      timeout=timeout)
        chunks.append((r0.stdout or "") + (r0.stderr or ""))
        if r0.returncode != 0:
            _cleanup_partial(target)
            die("镜像导出失败: %s" % (r0.stderr.strip()[-300:] or r0.stdout.strip()[-300:]))
        r1 = run(["scp", "-P", SSH_PORT, "-o", "BatchMode=yes",
                  "-o", "StrictHostKeyChecking=accept-new",
                  "root@%s:%s" % (node, local_tmp), target + ".tmp"], timeout=1800)
        ssh_node(node, ["rm", "-f", local_tmp], timeout=60)
        if r1.returncode != 0:
            _cleanup_partial(target)
            die("镜像回传 admin 失败: %s" % (r1.stderr.strip()[-300:] or r1.stdout.strip()[-300:]))
        os.replace(target + ".tmp", target)
    else:
        r = ssh_node(node, _as_user_argv(username, home, export_argv), timeout=timeout)
        chunks.append((r.stdout or "") + (r.stderr or ""))
        if r.returncode != 0:
            _cleanup_partial(target)
            die("镜像导出失败: %s" % (r.stderr.strip()[-300:] or r.stdout.strip()[-300:]))

    try:
        size = os.path.getsize(target)
    except OSError:
        size = 0
    if size <= 0:
        _cleanup_partial(target)
        die("镜像导出结果为空文件（导出被中断？），请重试")
    dur = int(_time.time() - t0)
    tail = "".join(chunks).strip()
    out({"ok": True, "user": username, "job_id": job_id, "name": name,
         "path": target, "size": size, "node": node,
         "duration_s": dur, "output": tail[-1500:]})


def _cleanup_partial(target):
    """删除导出失败/中断留下的半成品（admin 上真实 root，/share 为本地盘）。"""
    for p in (target, target + ".tmp", target + ".part"):
        try:
            if os.path.exists(p):
                os.remove(p)
        except OSError:
            pass



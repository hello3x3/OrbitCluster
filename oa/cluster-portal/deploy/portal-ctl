def _ensure_admin_scripts():
    need = ["add-user.sh", "set-quota.sh", "show-quota.sh"]
    missing = [f for f in need if not os.path.exists(os.path.join(CLUSTER_ADMIN_DIR, f))]
    if missing:
        die("缺少 %s，请先安装第 7 章管理脚本到 %s" % (",".join(missing), CLUSTER_ADMIN_DIR))


def _copy_scripts_to_nodes(nodes):
    """把 /opt/cluster-admin/add-user.sh 同步到计算节点（幂等）。"""
    host = node_hostname()
    src = os.path.join(CLUSTER_ADMIN_DIR, "add-user.sh")
    for n in nodes:
        if n == host:
            continue
        # 先确保远程目录存在（幂等），再决定是否拷贝
        r0 = ssh_node(n, ["mkdir", "-p", CLUSTER_ADMIN_DIR], timeout=30)
        if r0.returncode != 0:
            return False, "无法在 %s 创建 %s: %s" % (n, CLUSTER_ADMIN_DIR,
                                                    r0.stderr.strip()[:200])
        r1 = ssh_node(n, ["bash", "-c", "test -x %s/add-user.sh" % CLUSTER_ADMIN_DIR],
                      timeout=30)
        if r1.returncode == 0:
            continue  # 已存在
        rr = run(["scp", "-P", SSH_PORT, "-o", "BatchMode=yes",
                  "-o", "StrictHostKeyChecking=accept-new",
                  src, "root@%s:%s/add-user.sh" % (n, CLUSTER_ADMIN_DIR)], timeout=60)
        if rr.returncode != 0:
            return False, "向 %s 同步 add-user.sh 失败: %s" % (n, rr.stderr.strip()[:300])
        rc = ssh_node(n, ["chmod", "+x", "%s/add-user.sh" % CLUSTER_ADMIN_DIR], timeout=30)
        if rc.returncode != 0:
            return False, "在 %s 上 chmod +x add-user.sh 失败: %s" % (n, rc.stderr.strip()[:200])
    return True, ""


def cmd_provision_user(username, quota, skip_os, uid=None):
    if not valid_user(username):
        die("非法用户名")
    if not quota_valid(quota):
        die("非法配额值: %s（例 500G / 1T，或「不限」）" % quota)
    if uid is not None:
        # 允许调用方（测试/CI）把账号钉在指定 UID，例如保留号段 59000-59999，
        # 这样测试账号永远不会占用真实用户的 1000+ 号段
        if not str(uid).isdigit():
            die("--uid 必须是整数")
        if not (1000 <= int(uid) < 60000):   # login.defs 的 UID_MIN / UID_MAX
            die("--uid 必须在 [1000, 60000) 内")
        uid = str(int(uid))
    requested_uid = uid          # 调用方指定的 UID（None = 自动分配）
    host = node_hostname()
    nodes = compute_nodes()

    if skip_os:
        # 用户声称 OS 账号已存在 —— 校验并初始化目录
        r = run(["id", "-u", username])
        if r.returncode != 0:
            die("OS 账号 %s 在 %s 不存在，无法按“已存在”开通" % (username, host))
        uid = r.stdout.strip()
        if not uid.isdigit():
            die("读取 %s UID 失败" % username)
        if requested_uid and uid != requested_uid:
            die("--uid %s 与 %s 上 %s 的现有 UID(%s) 不符"
                % (requested_uid, host, username, uid))
        rg = run(["id", "-g", username])
        gid = rg.stdout.strip() if rg.returncode == 0 else ""
        gid_warn = []
        for n in nodes:
            if n == host:
                continue
            rr = ssh_node(n, ["id", "-u", username])
            if rr.returncode != 0 or rr.stdout.strip() != uid:
                die("OS 账号 %s 在 %s 上不存在或 UID(%s)与 admin(%s) 不一致；"
                    "请先在计算节点建号（add-user.sh %s -u %s -g %s）"
                    % (username, n, rr.stdout.strip() or "?", uid, username, uid, gid or "<GID>"))
            # UID 一致是硬要求：重复 UID 会让 enroot 只按 UID 注入一条 passwd 记录，
            # 容器内就解析不到该用户名，用户 ssh 报 Permission denied (publickey)。
            # GID 漂移不致命（只影响 NFS 上属组），因此只提示不阻断。
            rn = ssh_node(n, ["id", "-g", username])
            gid_n = rn.stdout.strip() if rn.returncode == 0 else ""
            if gid and gid_n and gid_n != gid:
                gid_warn.append("%s(GID %s≠%s)" % (n, gid_n, gid))
        _init_user_dirs(username, uid)
        # 「OS 账号已存在」这条路不会走 add-user.sh，必须在这里补会计关联，
        # 否则用户能申请但一提交就报 Invalid account or account/partition combination
        assoc_ok, assoc_err = _ensure_assoc(username)
        res = {"ok": True, "mode": "existing", "username": username, "uid": int(uid),
               "assoc": "ok" if assoc_ok else "warning: %s" % assoc_err}
        if gid.isdigit():
            res["gid"] = int(gid)
        if gid_warn:
            res["gid_mismatch"] = ("warning: 各节点 GID 与管理节点不一致 " + ",".join(gid_warn)
                                   + "；修正: groupmod -g <主节点GID> <用户> && usermod -g <主节点GID> <用户>")
        out(res)
        return

    _ensure_admin_scripts()
    ok, err = _copy_scripts_to_nodes(nodes)
    if not ok:
        die(err)

    # 1) admin 建号（建家目录 + 配额 + sacctmgr）
    build_argv = [os.path.join(CLUSTER_ADMIN_DIR, "add-user.sh"), username, quota]
    if uid:
        build_argv += ["-u", uid]
    r = run(build_argv, timeout=120)
    if r.returncode != 0:
        die("管理节点 %s 建号失败: %s" % (node_hostname(), r.stderr.strip()[:400] or r.stdout.strip()[:400]))
    if "已存在，跳过" in r.stdout:
        die("用户名 %s 已存在于管理节点 %s，拒绝重复开通（如需开通已存在账号请勾选“OS 账号已存在”）"
            % (username, host))

    r = run(["id", "-u", username])
    if r.returncode != 0:
        die("读取新用户 UID 失败")
    uid_now = r.stdout.strip()
    if uid and uid_now != uid:
        die("建号后 UID 不符：期望 %s，实际 %s" % (uid, uid_now or "?"))
    uid = uid_now

    # 主节点的 GID 是权威值，必须一并下发到计算节点：
    # 只对齐 UID 会让各计算节点自行取 GID，同一用户在 NFS 上的属组不一致
    # （曾经出现主节点 gid=1002、计算节点 gid=1003 的漂移）
    rg = run(["id", "-g", username])
    if rg.returncode != 0:
        die("读取新用户 GID 失败")
    gid = rg.stdout.strip()

    # 2) 计算节点建号（-u/-g 强制同 UID/GID）
    for n in nodes:
        if n == host:
            continue
        rr = ssh_node(n, [os.path.join(CLUSTER_ADMIN_DIR, "add-user.sh"),
                          username, "-u", uid, "-g", gid], timeout=60)
        if rr.returncode != 0:
            die("计算节点 %s 建号失败: %s" % (n, rr.stderr.strip()[:400] or rr.stdout.strip()[:400]))

    _init_user_dirs(username, uid)
    # add-user.sh 已经建过关联；这里幂等再确认一次，避免脚本被改动后静默退化
    _ensure_assoc(username)
    out({"ok": True, "mode": "new", "username": username, "uid": int(uid),
         "gid": int(gid) if gid.isdigit() else None,
         "quota": quota, "nodes": nodes})


def _ensure_assoc(username):
    """确保该用户在会计（sacctmgr）里有账户关联。**幂等**，返回 (ok, err)。

    为什么需要：集群开着 `AccountingStorageEnforce=associations` 时，没有关联的用户
    sbatch 会被直接拒掉，报
        Invalid account or account/partition combination specified
    经 `add-user.sh` 建号的用户会自动带上关联（脚本里有 `sacctmgr add user ... account=lab`），
    但**「OS 账号已存在」这条开通路径不走 add-user.sh**，历史上就漏了这一步 ——
    表现为"能登录门户、能点申请，但一提交就报上面那个错"。

    这里统一兜住：开通 / 初始化 / 提交前各确保一次。
    账户名取站点配置的 ACCOUNT（缺省 lab），与 add-user.sh 的 CLUSTER_ACCOUNT 对齐。
    """
    acct = SITE.get("ACCOUNT") or os.environ.get("CLUSTER_ACCOUNT") or "lab"
    r = run(["sacctmgr", "-n", "-P", "show", "assoc", "user=%s" % username,
             "format=Account"], timeout=30)
    if r.returncode != 0:
        return False, "查询会计关联失败: %s" % (r.stderr.strip() or r.stdout.strip())[:300]
    if r.stdout.strip():
        return True, ""
    rr = run(["sacctmgr", "-i", "add", "user", username,
              "account=%s" % acct, "qos=normal"], timeout=60)
    if rr.returncode != 0:
        return False, "建立会计关联失败: %s" % (rr.stderr.strip() or rr.stdout.strip())[:300]
    return True, ""


def _init_user_dirs(username, uid):
    """初始化 ~/.portal/logs 与 ~/.ssh。

    不用 `install -d`：它会**跟随符号链接**，把属主/权限作用到软链指向的真实目录上
    （实测：把软链指向 /etc/cron.d 再触发一次，真实目录属主就被改成了普通用户）。
    这里逐级 lstat 校验后自己 mkdir/chown/chmod。

    目录属主刻意保持现状：`~/.portal` 归 root（用户无法在其中增删条目，因此不能把
    logs 换成软链）；`~/.portal/logs` 与 `~/.ssh` 归用户（日志与公钥本来就由该用户维护）。
    """
    home, err = checked_home(username)
    if err:
        die(err)
    if os.path.islink(home):
        die("家目录 %s 是符号链接，拒绝初始化" % home)
    if not os.path.isdir(home):
        die("用户家目录不存在：%s" % home)
    _ensure_user_dir(username, 0, os.path.join(home, ".portal"), 0o755)
    _ensure_user_dir(username, uid, os.path.join(home, ".portal", "logs"), 0o755)
    ssh_dir = os.path.join(home, ".ssh")
    _ensure_user_dir(username, uid, ssh_dir, 0o700)
    ak = os.path.join(ssh_dir, "authorized_keys")
    if os.path.lexists(ak):
        st = os.lstat(ak)
        if not stat.S_ISREG(st.st_mode):
            die("%s 已存在但不是普通文件（疑似符号链接），拒绝继续" % ak)
        os.chmod(ak, 0o600)
    else:
        fd = os.open(ak, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        os.close(fd)
        os.chown(ak, int(uid), int(uid))
        os.chmod(ak, 0o600)
    return True


def cmd_init_user(username):
    if not valid_user(username):
        die("非法用户名")
    r = run(["id", "-u", username])
    if r.returncode != 0:
        die("OS 账号 %s 在 %s 不存在" % (username, node_hostname()))
    uid = r.stdout.strip()
    _init_user_dirs(username, uid)
    assoc_ok, assoc_err = _ensure_assoc(username)
    out({"ok": True, "username": username, "uid": int(uid),
         "assoc": "ok" if assoc_ok else "warning: %s" % assoc_err})


def cmd_unprovision_user(username):
    """注销 OS 账号（删除家目录数据！）。仅供管理员手动清理/测试。"""
    if not valid_user(username):
        die("非法用户名")
    host = node_hostname()
    r = run(["id", "-u", username])
    if r.returncode != 0:
        out({"ok": True, "username": username, "skipped": "not-exists"})
        return
    uid = r.stdout.strip()
    # 再加一道"像不像门户代建用户"的判断：仅靠名字黑名单不够 ——
    # sshd / messagebus / mysql / chrony 等系统账号都不在名单里，
    # 一旦被 `userdel -r` 就会破坏宿主机（例如删掉 /run/sshd 让 sshd 起不来）。
    # 只允许"正常用户号段 + 家目录在 /share/home 之下"的账号被注销。
    home = user_home(username)
    try:
        uid_i = int(uid)
    except ValueError:
        die("读取 %s UID 失败" % username)
    if not (1000 <= uid_i < 60000) or not home.startswith(SHARE_HOME.rstrip("/") + "/"):
        die("拒绝注销账号 %s：UID=%s、家目录=%s，不像门户代建用户"
            "（仅允许 UID∈[1000,60000) 且家目录位于 %s 之下）"
            % (username, uid, home, SHARE_HOME))
    import time
    # 杀掉该用户所有作业，等待队列清空（容器回收）
    run(["runuser", "-u", username, "--", "scancel", "-u", username], timeout=60)
    for _ in range(20):
        left = sh_out(["squeue", "-h", "-u", username, "-o", "%i"], timeout=30)
        if not left:
            break
        time.sleep(2)

    def _exists_on(node):
        argv = ["id", "-u", username]
        return (run(argv, timeout=30) if node == host else ssh_node(node, argv, timeout=30)).returncode == 0

    def _del_on_node(node, rm_home=False):
        # 幂等：本机/该节点本来就没有这个账号，也算"删干净"。
        # 否则 userdel 对不存在的账号返回非 0，会被误报成"删除残留失败" ——
        # 而"只在某一个节点上存在的残留账号"正是最需要能干净注销的情况
        # （例如历史上在计算节点上用裸 useradd 建出来、没清理的测试账号）。
        if not _exists_on(node):
            return True
        argv = ["userdel"] + (["-r"] if rm_home else []) + [username]
        last = ssh_node(node, argv, timeout=60) if node != host else run(argv, timeout=120)
        for _ in range(5):
            if last.returncode == 0:
                return True
            time.sleep(3)
            last = ssh_node(node, argv, timeout=60) if node != host else run(argv, timeout=120)
        if not _exists_on(node):
            return True
        return last

    # 先删计算节点（进程/容器在本机，避免 admin 家目录删除时被占用）
    node_fail = []
    for n in compute_nodes():
        if n == host:
            continue
        if _del_on_node(n) is not True:
            node_fail.append(n)
    # admin: userdel -r（删除 NFS 家目录数据）
    ar = _del_on_node(host, rm_home=True)
    if ar is not True:
        node_fail.append(host)
    # 个人镜像目录 /share/images/<user> 一并清理（root 删除，/share 为 admin 本地盘）
    imgdir = os.path.join(IMAGES_ROOT, username)
    if os.path.isdir(imgdir):
        run(["rm", "-rf", imgdir], timeout=120)
    # sacctmgr 关联清理
    run(["sacctmgr", "-i", "delete", "user", "name=%s" % username], timeout=60)
    if node_fail:
        out({"ok": False, "error": "以下节点删除账号残留失败: %s，请手动 userdel %s"
             % (",".join(node_fail), username)}, code=1)
    out({"ok": True, "username": username, "uid": int(uid)})


def cmd_user_status(username):
    if not name_ok(username):
        die("非法用户名")
    host = node_hostname()
    uid = sh_out(["id", "-u", username])
    nodes = {}
    for n in compute_nodes():
        if n == host:
            nodes[n] = {"uid": uid if uid else None}
        else:
            r = ssh_node(n, ["id", "-u", username], timeout=30)
            nodes[n] = {"uid": r.stdout.strip() if r.returncode == 0 else None}
    assoc = sh_out(["sacctmgr", "-n", "-P", "show", "assoc",
                    "user=%s" % username, "format=Account"], timeout=30)
    home = user_home(username)
    out({"ok": True, "username": username, "uid_admin": uid or None,
         "exists": bool(uid), "nodes": nodes,
         "sacct_account": assoc.split("|")[0] if assoc else "",
         "home_exists": os.path.isdir(home)})



# ----------------------------------------------------------------------------
# 额外透传给容器的宿主机路径（NAS / 数据集共享盘）
#
# 只从**站点配置或环境**读，**绝不接受请求参数**：门户 web 在威胁模型里是不可信组件，
# 一旦让它传路径，攻破门户就能传 --container-mounts=/var/lib/cluster-portal:/x，
# 把门户 DB 与 Flask secret 挂进用户容器读走。
#
# 站点配置写法（每项 <宿主路径>[:<容器内路径>][:ro|rw]，默认 ro；多项用 ";" 分隔）：
#   EXTRA_MOUNTS=/data:/data:ro;/mnt/nas219:/mnt/nas219:ro
# 环境变量 PORTAL_EXTRA_MOUNTS 优先（便于测试/临时启用）。
# ----------------------------------------------------------------------------
EXTRA_MOUNTS_RAW = os.environ.get("PORTAL_EXTRA_MOUNTS") or SITE.get("EXTRA_MOUNTS") or ""

# 绝不允许透传的前缀：门户自己的数据/配置、以及宿主机系统目录。
# 站点配置是 root 维护的，这里再拦一道是防"手滑写错一行就把门户 DB 挂给用户"。
EXTRA_MOUNT_DENY = ("/var/lib/cluster-portal", "/etc/cluster-portal", "/root",
                    "/etc", "/proc", "/sys", "/dev", "/boot", "/run")


def _parse_extra_mounts(raw):
    """解析 EXTRA_MOUNTS。任何一项不合法就 die（fail closed，而不是悄悄少挂一个）。"""
    items = []
    for chunk in re.split(r"[;\n]", raw or ""):
        spec = chunk.strip()
        if not spec:
            continue
        parts = [x.strip() for x in spec.split(":")]
        if len(parts) > 3:
            die("EXTRA_MOUNTS 项格式错误（最多 3 段 src:dst:flags）: %s" % spec)
        src = parts[0]
        dst = parts[1] if len(parts) > 1 and parts[1] else src
        flags = (parts[2].lower() if len(parts) > 2 and parts[2] else "ro")
        if ".." in src.split("/") or ".." in dst.split("/"):
            die("EXTRA_MOUNTS 不允许包含 ..: %s" % spec)
        if not os.path.isabs(src) or not os.path.isabs(dst):
            die("EXTRA_MOUNTS 必须是绝对路径: %s" % spec)
        if flags not in ("ro", "rw"):
            die("EXTRA_MOUNTS 的 flags 只允许 ro / rw: %s" % spec)
        for bad in EXTRA_MOUNT_DENY:
            if src == bad or src.startswith(bad.rstrip("/") + "/"):
                die("EXTRA_MOUNTS 拒绝透传 %s（命中禁止前缀 %s）—— 门户数据/系统目录"
                    "绝不能挂进用户容器" % (src, bad))
        items.append({"src": src, "dst": dst, "flags": flags})
    return items


def extra_mounts():
    """当前生效的额外挂载（惰性解析：配置写错只影响提交作业，不会让门户整站不可用）。"""
    return _parse_extra_mounts(EXTRA_MOUNTS_RAW)


def _container_mounts_arg(home):
    """拼 sbatch 的 --container-mounts 值：家目录 + 站点配置里的额外挂载（顺序稳定）。"""
    items = ["%s:%s" % (home, home)]
    items += ["%s:%s:%s" % (m["src"], m["dst"], m["flags"]) for m in extra_mounts()]
    return ",".join(items)


def _check_extra_mount_sources():
    """提交前确认**每台计算节点**上都有这些源目录。

    不做这步的话，作业落到缺挂载的那台节点时会在容器启动阶段 bind 失败，
    用户只看到"提交成功、几秒后失败"，日志里一句 No such file or directory。
    """
    ms = extra_mounts()
    if not ms:
        return
    srcs = [m["src"] for m in ms]
    script = "; ".join("test -d %s || echo %s" % (_shq(p), _shq(p)) for p in srcs)
    host = node_hostname()
    bad = []
    for n in compute_nodes():
        r = (run(["bash", "-c", script], timeout=30) if n == host
             else ssh_node(n, ["bash", "-c", script], timeout=30))
        miss = [x for x in (r.stdout or "").split() if x]
        if miss:
            bad.append("%s: %s" % (n, "、".join(miss)))
    if bad:
        die("以下节点上没有 EXTRA_MOUNTS 里配的挂载点，容器会因 bind 失败起不来 —— "
            "请先在该节点挂载（并写进 fstab），或从 site.conf 的 EXTRA_MOUNTS 里去掉：%s"
            % "；".join(bad))



def user_home(username):
    """真实 OS 家目录（root 的 /root 等也能正确解析），失败回退 /share/home/<user>。"""
    r = run(["getent", "passwd", username], timeout=20)
    parts = r.stdout.split(":")
    if r.returncode == 0 and len(parts) >= 7 and parts[0] == username and parts[5]:
        return parts[5]
    return os.path.join(SHARE_HOME, username)

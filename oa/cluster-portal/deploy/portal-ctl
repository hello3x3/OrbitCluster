QUOTA_SIZE_RE = re.compile(r"^[1-9][0-9]{0,3}[GgTt]$")


def _quota_rows():
    """repquota CSV -> {user: {used_kb, soft_kb, hard_kb, files_used, ...}}"""
    import csv
    import io
    r = run(["repquota", "-u", "/share", "-O", "csv"], timeout=60)
    if r.returncode != 0:
        return {}
    out = {}
    for row in csv.DictReader(io.StringIO(r.stdout)):
        u = (row.get("User") or "").strip()
        if not u:
            continue
        try:
            out[u] = {
                "used_kb": int(float(row.get("BlockUsed") or 0)),
                "soft_kb": int(float(row.get("BlockSoftLimit") or 0)),
                "hard_kb": int(float(row.get("BlockHardLimit") or 0)),
                "files_used": int(float(row.get("FileUsed") or 0)),
                "files_soft": int(float(row.get("FileSoftLimit") or 0)),
                "files_hard": int(float(row.get("FileHardLimit") or 0)),
            }
        except (TypeError, ValueError):
            continue
    return out


def cmd_quota(username):
    """单个用户的 /share 实际配额（无配额记录=不限）。"""
    if not name_ok(username):
        die("非法用户名")
    if run(["id", "-u", username]).returncode != 0:
        die("OS 账号 %s 不存在，无法读取配额" % username)
    row = _quota_rows().get(username)
    if not row:
        out({"ok": True, "username": username, "exists": True,
             "used_kb": 0, "soft_kb": 0, "hard_kb": 0,
             "files_used": 0, "files_soft": 0, "files_hard": 0,
             "note": "该账号无配额记录（视为不限）"})
    row["ok"] = True
    row["username"] = username
    row["exists"] = True
    out(row)


def cmd_quota_all():
    rows = _quota_rows()
    out({"ok": True, "quotas": rows})


def cmd_set_quota(username, size):
    """设置 /share 配额（软=硬）。校验后调用 /opt/cluster-admin/set-quota.sh。"""
    if not valid_user(username):
        die("非法用户名（不能对系统/保留账号设置配额）")
    if run(["id", "-u", username]).returncode != 0:
        die("OS 账号 %s 不存在" % username)
    if not QUOTA_SIZE_RE.match(size or ""):
        die("配额格式错误: %s（例 100G / 500G / 1T）" % size)
    if not os.path.isfile(os.path.join(CLUSTER_ADMIN_DIR, "set-quota.sh")):
        die("缺少 %s/set-quota.sh" % CLUSTER_ADMIN_DIR)
    # 仅 admin 本机可设（set-quota.sh 内部也会检查）
    if node_hostname() != "admin":
        die("配额只能在 admin 节点设置")
    r = run(["bash", os.path.join(CLUSTER_ADMIN_DIR, "set-quota.sh"), username, size],
            timeout=90)
    if r.returncode != 0:
        die("set-quota 失败: %s" % (r.stderr.strip()[-300:] or r.stdout.strip()[-300:]))
    row = _quota_rows().get(username) or {}
    out({"ok": True, "username": username, "requested": size,
         "used_kb": row.get("used_kb", 0), "soft_kb": row.get("soft_kb", 0),
         "hard_kb": row.get("hard_kb", 0)})



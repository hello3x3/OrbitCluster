def cmd_ping():
    out({"ok": True, "whoami": sh_out(["id", "-un"]), "host": node_hostname()})


def _gres_count(s):
    """从 `gpu:3060:1(S:0)` / `gpu:3060:2(S:0-1)` / `gpu:3060:1(IDX:0)` 里取卡数合计。"""
    n = 0
    for item in (s or "").split(","):
        m = re.search(r":(\d+)(?:\(|$)", item.strip())
        if m:
            n += int(m.group(1))
    return n


def _gres_model(s):
    """从 `gpu:3060:1(S:0)` 里取型号（3060），只用于页面展示。"""
    m = re.search(r"^[A-Za-z0-9_]+:([^:()]+):\d+", (s or "").strip())
    return m.group(1) if m else ""


def _nodes_alloc_mem():
    """节点 -> 已分配内存(MB)。sinfo 没有这个字段，只能问 scontrol（一次列出全部节点）。

    口径很重要：**不要**拿 sinfo 的 %e / scontrol 的 FreeMem 当「空闲内存」—— 那是 OS 的
    空闲内存，受 page cache 影响（实测一台完全空闲的 32G 节点只剩 686M「空闲」），
    拿它当"节点快满了"会把人误导死。调度口径的空闲 = RealMemory - AllocMem。
    """
    got = {}
    raw = sh_out(["scontrol", "show", "node"], timeout=30)
    for chunk in raw.split("NodeName=")[1:]:
        parts = chunk.split()
        if not parts:
            continue
        m = re.search(r"\bAllocMem=(\d+)", chunk)
        if m:
            got[parts[0].strip()] = int(m.group(1))
    return got


def _nodes_gres_used():
    """节点 -> 已用 GPU 卡数。sinfo 的 -o 短说明符里没有「已用 GRES」，只能走 --Format。"""
    used = {}
    raw = sh_out(["sinfo", "-h", "-p", partition_name(), "-N",
                  "--Format=NodeList,GresUsed"], timeout=30)
    for ln in raw.splitlines():
        f = ln.split(None, 1)
        if len(f) == 2 and f[0]:
            used[f[0].strip()] = _gres_count(f[1].strip())
    return used


def cmd_extra_mounts():
    """额外透传挂载的诊断：解析结果 + 每台节点上源目录是否存在（排障/验收用）。

    纯读取，不 ssh 执行任何有副作用的命令。
    """
    ms = extra_mounts()
    host = node_hostname()
    nodes_missing = {}
    if ms:
        srcs = [m["src"] for m in ms]
        script = "; ".join("test -d %s || echo %s" % (_shq(p), _shq(p)) for p in srcs)
        for n in compute_nodes():
            r = (run(["bash", "-c", script], timeout=30) if n == host
                 else ssh_node(n, ["bash", "-c", script], timeout=30))
            miss = [x for x in (r.stdout or "").split() if x]
            nodes_missing[n] = miss
    out({"ok": True, "raw": EXTRA_MOUNTS_RAW,
         "source": "PORTAL_EXTRA_MOUNTS" if os.environ.get("PORTAL_EXTRA_MOUNTS")
                   else ("site.conf" if SITE.get("EXTRA_MOUNTS") else "未配置"),
         "mounts": ms,
         "container_mounts": ",".join("%s:%s:%s" % (m["src"], m["dst"], m["flags"]) for m in ms),
         "missing": nodes_missing})


def cmd_sinfo():
    part = partition_name()
    raw = sh_out(["sinfo", "-h", "-p", part, "-N", "-o", "%N|%T|%C|%G|%m|%a"],
                 timeout=30)
    fields = [ln.strip().split("|") for ln in raw.splitlines()]
    fields = [f for f in fields if len(f) >= 6]
    ips = nodes_ips([f[0] for f in fields])
    # 页面上要让每个资源都显示「空闲/总」，而 sinfo 只给总量：内存的已用量只有 scontrol 有，
    # GPU 的已用量只有 sinfo --Format 有。两次额外调用都很轻（各 ~40ms）。
    # 取不到就置 None，页面显示「—」，绝不假装 0（假装 0 会显示成"全部空闲"）。
    alloc_mem = _nodes_alloc_mem()
    gres_used = _nodes_gres_used()
    nodes = []
    for f in fields:
        name, state, cpus, gres, mem_mb, avail = f[0], f[1], f[2], f[3], f[4], f[5]
        ca = ci = co = ct = 0
        m = re.match(r"^(\d+)/(\d+)/(\d+)/(\d+)$", cpus)
        if m:
            ca, ci, co, ct = (int(x) for x in m.groups())
        try:
            mem = int(mem_mb)
        except ValueError:
            mem = 0
        gt = _gres_count(gres)
        am = alloc_mem.get(name)
        gu = gres_used.get(name)
        nodes.append({
            "name": name, "state": state, "avail": avail,
            "cpus_alloc": ca, "cpus_idle": ci, "cpus_other": co, "cpus_total": ct,
            "mem_mb": mem, "gres": gres,
            "mem_alloc_mb": am,
            "mem_free_mb": (max(0, mem - am) if am is not None else None),
            "gres_model": _gres_model(gres),
            "gres_total": gt,
            "gres_used": gu,
            "gres_free": (max(0, gt - gu) if gu is not None else None),
            "ip": ips.get(name, ""),
        })
    out({"ok": True, "partition": part, "nodes": nodes})



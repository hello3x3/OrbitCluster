def cmd_get_keys(user):
    """读取某用户 authorized_keys 中的有效公钥行（root 才有权限读 600 文件）。"""
    if not valid_user(user):
        die("非法用户名或系统保留账号: %s" % user)
    home, herr = checked_home(user)
    if herr:
        die(herr)
    ak = os.path.join(home, ".ssh", "authorized_keys")
    keys = []
    if os.path.lexists(ak):
        # 同样拒绝软链：~/.ssh/authorized_keys 可以被换成指向任意 root 可读文件的软链
        fd, oerr = _open_user_file(user, ak, os.O_RDONLY)
        if oerr:
            die("读取 authorized_keys 失败：%s" % oerr)
        try:
            with os.fdopen(fd, "r", encoding="utf-8", errors="replace") as fh:
                for ln in fh:
                    s = ln.strip()
                    if s and PUBKEY_RE.match(s) and s not in keys:
                        keys.append(s)
        except OSError:
            pass
    out({"ok": True, "user": user, "keys": keys})


def cmd_set_keys(user):
    if not valid_user(user):
        die("非法用户名或系统保留账号: %s" % user)
    try:
        keys = json.load(sys.stdin)
    except Exception:
        die("stdin 不是合法 JSON")
    if not isinstance(keys, list) or len(keys) > 32:
        die("公钥列表非法（最多 32 条）")
    cleaned = []
    for k in keys:
        if not isinstance(k, str) or not PUBKEY_RE.match(k.strip()):
            die("存在非法公钥格式（仅支持 OpenSSH 格式，一行一条）")
        cleaned.append(k.strip())
    if len(set(cleaned)) != len(cleaned):
        die("存在重复公钥")
    r = run(["id", "-u", user])
    if r.returncode != 0:
        die("OS 账号 %s 不存在" % user)
    uid = int(r.stdout.strip())
    home, herr = checked_home(user)
    if herr:
        die(herr)
    sshd_dir = os.path.join(home, ".ssh")
    # 安全：~/.ssh 属于用户本人（0700），因此用户可以在这里建软链。
    # 历史实现把临时文件写成 authorized_keys + ".portal-tmp"（固定可猜名）并用
    # open(...,"w") 写 —— 用户只需
    #     ln -s /root/.ssh/authorized_keys ~/.ssh/authorized_keys.portal-tmp
    # 就能让 root 把公钥写进 /root/.ssh/authorized_keys。
    # 现在：① 逐级拒绝软链；② 目标必须属主正确；③ 临时文件建在 root 私有目录。
    err = _link_free_chain(user, sshd_dir)
    if err:
        die("写入 authorized_keys 失败：%s" % err)
    if os.path.islink(sshd_dir) or not os.path.isdir(sshd_dir):
        die("写入 authorized_keys 失败：%s 不是目录或为符号链接" % sshd_dir)
    if os.lstat(sshd_dir).st_uid != uid:
        die("写入 authorized_keys 失败：%s 的属主不是 %s" % (sshd_dir, user))
    ak = os.path.join(sshd_dir, "authorized_keys")
    if os.path.lexists(ak) and not stat.S_ISREG(os.lstat(ak).st_mode):
        die("写入 authorized_keys 失败：%s 已存在但不是普通文件（疑似符号链接）" % ak)

    # 临时文件：必须与目标**同一个文件系统**（否则 os.replace 会 EXDEV —— /run 是 tmpfs，
    # 家目录在 NFS 上），因此建在 .ssh 目录内，但满足两个关键约束：
    #   ① 名字随机（tempfile.mkstemp），不是可猜的 固定名；
    #   ② 以 O_CREAT|O_EXCL|O_NOFOLLOW 打开 → 用户预置的软链只会让 open 直接 EEXIST 失败，
    #      绝不可能被"跟随"（历史漏洞正是 open("authorized_keys.portal-tmp","w") 跟随软链）。
    # 写入后按 **inode** 校验替换结果，防止用户在替换窗口内掉包。
    try:
        fd, tmp = tempfile.mkstemp(prefix=".ak-", dir=sshd_dir)
    except OSError as e:
        die("写入 authorized_keys 失败（无法创建临时文件）: %s" % e)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("\n".join(cleaned) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
            st_created = os.fstat(fh.fileno())
        os.chmod(tmp, 0o600)
        os.chown(tmp, uid, uid)
        # os.replace 替换的是目录项本身，不跟随软链；同文件系统内是原子操作
        os.replace(tmp, ak)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        die("写入 authorized_keys 失败: %s" % e)
    try:
        st_now = os.lstat(ak)
    except OSError as e:
        die("写入 authorized_keys 失败：结果不可读 %s" % e)
    if (not stat.S_ISREG(st_now.st_mode)
            or st_now.st_ino != st_created.st_ino
            or st_now.st_dev != st_created.st_dev
            or os.path.islink(ak)):
        try:
            os.unlink(ak)
        except OSError:
            pass
        die("写入 authorized_keys 失败：写入结果被替换（检测到符号链接/掉包），已回滚")
    out({"ok": True, "user": user, "keys": len(cleaned),
         "path": ak})



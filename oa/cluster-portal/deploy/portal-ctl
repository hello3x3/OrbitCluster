def cmd_account_add_user(name, user, make_default=False):
    """把用户加入账户（幂等）；--default 时同时设为用户的默认账户。"""
    if not valid_account(name):
        die("非法账户名: %s（须匹配 %s）" % (name, ACCOUNT_RE.pattern))
    if not valid_user(user):
        die("非法用户名或系统保留账号: %s" % user)
    accts = _accounts_in_slurm()
    if accts is None:
        die("查询 Slurm 账户失败（slurmdbd 未运行或无权限？）")
    if name not in accts:
        die("账户不存在: %s" % name)
    if run(["id", "-u", user]).returncode != 0:
        die("OS 账号 %s 不存在，无法加入账户" % user)
    qos = acct_qos(name)
    names = _user_account_names(user)
    if names is None:
        die("查询 %s 的会计关联失败（sacctmgr 不可用？）" % user)
    added = False
    if name not in names:
        ok, err = _account_ensure(name)
        if not ok:
            die(err)
        ok, err = _add_user_assoc(user, name)
        if not ok:
            die(err)
        added = True
    default = False
    if make_default:
        ok, err = _set_default_account(user, name)
        if not ok:
            die(err)
        default = True
    else:
        defaults = _user_defaults()
        default = bool(defaults is not None and defaults.get(user, "") == name)
    out({"ok": True, "account": name, "user": user, "qos": qos,
         "added": added, "default": default})



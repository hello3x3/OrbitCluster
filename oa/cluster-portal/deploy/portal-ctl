def main():
    if len(sys.argv) < 2:
        die("用法: %s <command> [...]" % CTL)
    cmd = sys.argv[1]
    try:
        if cmd == "ping":
            cmd_ping()
        elif cmd == "sinfo":
            cmd_sinfo()
        elif cmd == "provision-user":
            if len(sys.argv) < 4:
                die("用法: provision-user <用户名> <配额> [--skip-os] [--uid N]")
            rest = sys.argv[4:]
            uid_opt = None
            if "--uid" in rest:
                i = rest.index("--uid")
                if i + 1 >= len(rest):
                    die("--uid 需要一个整数值")
                uid_opt = rest[i + 1]
            cmd_provision_user(sys.argv[2], sys.argv[3], "--skip-os" in rest, uid_opt)
        elif cmd == "unprovision-user":
            if len(sys.argv) < 3:
                die("用法: unprovision-user <用户名>")
            cmd_unprovision_user(sys.argv[2])
        elif cmd == "init-user":
            if len(sys.argv) < 3:
                die("用法: init-user <用户名>")
            cmd_init_user(sys.argv[2])
        elif cmd == "ensure-assoc":
            if len(sys.argv) < 3:
                die("用法: ensure-assoc <用户名>")
            if not valid_user(sys.argv[2]):
                die("非法用户名或系统保留账号: %s" % sys.argv[2])
            ok, err = _ensure_assoc(sys.argv[2])
            if not ok:
                die(err)
            out({"ok": True, "user": sys.argv[2], "assoc": "ok"})
        elif cmd == "user-status":
            if len(sys.argv) < 3:
                die("用法: user-status <用户名>")
            cmd_user_status(sys.argv[2])
        elif cmd == "submit":
            cmd_submit()
        elif cmd == "kill":
            if len(sys.argv) < 4:
                die("用法: kill <用户名> <jobid>")
            cmd_kill(sys.argv[2], sys.argv[3])

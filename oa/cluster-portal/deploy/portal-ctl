def _note_path(image_path):
    """镜像的"同名 json"路径：<名>.sqsh → <名>.json（同目录），用来存注释等元数据。"""
    return image_path[:-5] + ".json" if image_path.lower().endswith(".sqsh") else image_path + ".json"


def _read_note(image_path):
    """读镜像的同名 json；不存在/不是合法 JSON 时返回 {}（坏文件不该让列表挂掉）。"""
    try:
        with open(_note_path(image_path), "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _write_note(image_path, **fields):
    """合并写镜像的同名 json（原子替换；文件 644，与镜像同目录）。"""
    data = _read_note(image_path)
    data.update({k: v for k, v in fields.items() if v is not None})
    data.setdefault("name", os.path.basename(image_path)[:-5]
                    if image_path.lower().endswith(".sqsh") else os.path.basename(image_path))
    data["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
    tmp = _note_path(image_path) + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=2, sort_keys=True)
        fh.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, _note_path(image_path))
    return data


def _drop_note(image_path):
    for p in (_note_path(image_path), _note_path(image_path) + ".tmp"):
        try:
            if os.path.lexists(p):
                os.remove(p)
        except OSError:
            pass


def _move_note(old_path, new_path):
    """改名时把同名 json 一起改名（没有就跳过）。"""
    src, dst = _note_path(old_path), _note_path(new_path)
    try:
        if os.path.lexists(src):
            os.replace(src, dst)
            data = _read_note(new_path)
            data["name"] = os.path.basename(new_path)[:-5]
            _write_note(new_path, name=data["name"])
    except OSError:
        pass


def _list_image_dir(d, owner=""):
    """列出某个镜像目录里的 *.sqsh（跳过 .part 等半成品；软链一律忽略）。"""
    out_rows = []
    if not os.path.isdir(d):
        return out_rows
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return out_rows
    for f in names:
        if not f.lower().endswith(".sqsh"):
            continue
        p = os.path.join(d, f)
        try:
            if os.path.islink(p) or not os.path.isfile(p):
                continue
            st = os.stat(p)
        except OSError:
            continue
        meta = _read_note(p)
        out_rows.append({"name": f, "path": p, "owner": owner,
                         "scope": "public" if not owner else "user",
                         "size": st.st_size, "mtime": int(st.st_mtime),
                         "note": meta.get("note", ""),
                         "created_at": meta.get("created_at", ""),
                         "job_id": meta.get("job_id"),
                         "node": meta.get("node", "")})
    return out_rows



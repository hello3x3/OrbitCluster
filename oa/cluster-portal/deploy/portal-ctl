def _parse_account_opts(argv):
    """解析 --accounts a,b / --default-account x（也接受 KEY=VALUE 写法）。

    返回 (accounts|None, default|None, err)：
      accounts=None 表示**没传**（旧行为：site.conf 默认账户单个）；
      accounts=[]   表示**显式传了空列表**（管理员角色允许不选账户）。
    """
    accounts = None
    default = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--accounts":
            if i + 1 >= len(argv):
                return None, None, "--accounts 需要一个逗号分隔的账户列表"
            accounts = [x.strip() for x in argv[i + 1].split(",") if x.strip()]
            i += 2
        elif a.startswith("--accounts="):
            accounts = [x.strip() for x in a.split("=", 1)[1].split(",") if x.strip()]
            i += 1
        elif a == "--default-account":
            if i + 1 >= len(argv):
                return None, None, "--default-account 需要一个账户名"
            default = argv[i + 1].strip()
            i += 2
        elif a.startswith("--default-account="):
            default = a.split("=", 1)[1].strip()
            i += 1
        else:
            return None, None, "未知参数: %s" % a
    return accounts, default, None



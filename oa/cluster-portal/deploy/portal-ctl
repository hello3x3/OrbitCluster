# ----------------------------------------------------------------------------
# 站点配置（与 portalapp/siteconf.py 读同一个文件，保持两端行为一致）
#   /etc/cluster-portal/site.conf  每行 KEY=VALUE，# 起注释
#   本站点认的键：SSH_PORT、IMAGES_MOUNT（镜像目录）<其它键由门户进程使用>
# 节点名不在这里配置：一律经 sinfo 运行时探测，节点 IP 从 /etc/hosts 解析。
# ----------------------------------------------------------------------------
SITE_CONF = os.environ.get("PORTAL_SITE_CONF", "/etc/cluster-portal/site.conf")


def _load_site_conf(path):
    cfg = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for raw in fh:
                ln = raw.split("#", 1)[0].strip()
                if not ln or "=" not in ln:
                    continue
                k, v = ln.split("=", 1)
                k = k.strip().upper()
                if not k:
                    continue
                # EXTRA_MOUNTS 允许**分多行写**，每行一项，读的时候用 ";" 拼起来：
                # 十几个 NAS 路径挤成一行根本没法增删/注释，维护时必然写错。
                # 其它键保持"后写覆盖前写"的原语义。
                if k == "EXTRA_MOUNTS" and k in cfg:
                    cfg[k] = cfg[k] + ";" + v.strip()
                else:
                    cfg[k] = v.strip()
    except OSError:
        pass
    return cfg


SITE = _load_site_conf(SITE_CONF)

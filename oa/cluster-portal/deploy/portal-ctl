NOTE_MAX = 64          # 注释上限（按"看得见的字符"数，一个表情算 1 个）
_NOTE_JOINERS = (0x200D, 0xFE0E, 0xFE0F)      # ZWJ / 变体选择符
_NOTE_COMBINING = ((0x0300, 0x036F), (0x1AB0, 0x1AFF), (0x20D0, 0x20FF), (0xFE20, 0xFE2F))


def note_len(text):
    """注释长度：表情/国旗/组合符号都按"看得见的字符"算 1 个。

    - ZWJ、变体选择符、肤色修饰、组合记号不计；
    - 相邻两个区域指示符（国旗 emoji）算 1 个；
    - 其余每个码位算 1 个（中文/emoji/空格都一样）。
    """
    n = 0
    ri_pending = False
    join_next = False
    for ch in text or "":
        cp = ord(ch)
        if cp == 0x200D:                      # ZWJ：下一个基字符并入同一簇（👨‍👩‍👧‍👦）
            join_next = True
            continue
        if cp in (0xFE0E, 0xFE0F) or 0x1F3FB <= cp <= 0x1F3FF:
            continue                          # 变体选择符 / 肤色修饰：不计
        if any(a <= cp <= b for a, b in _NOTE_COMBINING):
            continue                          # 组合记号：并入前一个字符
        if 0x1F1E6 <= cp <= 0x1F1FF:          # 国旗：两个区域指示符合起来算 1
            if ri_pending:
                ri_pending = False
                continue
            ri_pending = True
            n += 1
            continue
        ri_pending = False
        if join_next:
            join_next = False
            continue
        n += 1
    return n


def cmd_set_image_note(owner, name, note):
    """写镜像注释（存在同目录同名 .json 里；owner=public 指公共镜像）。"""
    path = _any_image_path(owner, name)
    # 空格/表情都允许：空白（含换行/制表/零宽空格）折成一个空格，再去首尾
    text = re.sub(r"[\s\u200b]+", " ", note or "").strip()
    if note_len(text) > NOTE_MAX:
        die("注释最多 %d 个字符（表情算 1 个），当前 %d 个"
            % (NOTE_MAX, note_len(text)))
    old = _read_note(path).get("note", "")
    _write_note(path, note=text)
    out({"ok": True, "path": path, "note": text, "len": note_len(text),
         "cleared": bool(old) and not text})


def _any_image_path(owner, name, require=True, creating=False):
    """管理员操作的目标路径：owner 为 public 时是顶层公共镜像，否则是该用户目录下的镜像。

    只接受 <IMAGES_ROOT>/[<owner>/]<name>.sqsh 这个形状（都是校验过的名字，不含路径分隔符），
    并要求是普通文件、非软链 —— 管理员可以动任何人的镜像，所以这里**不做属主校验**。
    """
    if owner in ("", "public", "-"):
        if not PUBLIC_IMG_NAME_RE.match(name or ""):
            die("公共镜像名只能包含英文/数字/点/横线/下划线/加号（1-128 位，不能以点开头）: %s"
                % name)
        path = os.path.join(IMAGES_ROOT, name + ".sqsh")
    else:
        if not (IMG_NAME_RE if creating else PUBLIC_IMG_NAME_RE).match(name or ""):
            die(("镜像名只能包含 %s: %s" % (IMG_NAME_HINT, name)) if creating
                else "镜像名不合法（只允许文件安全字符、不以点开头、≤128 位）: %s" % name)
        if not USER_RE.match(owner or ""):
            die("非法用户名: %s" % owner)
        path = os.path.join(IMAGES_ROOT, owner, name + ".sqsh")
    if not os.path.lexists(path):
        if require:
            die("镜像不存在: %s" % path)
        return path
    if os.path.islink(path):
        die("镜像不能是符号链接：%s" % path)
    if not stat.S_ISREG(os.lstat(path).st_mode):
        die("镜像必须是普通文件（拒绝目录/设备）：%s" % path)
    return path



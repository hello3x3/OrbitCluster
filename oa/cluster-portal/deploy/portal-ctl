# Slurm 关联 / QoS / 优先级 / 限额（经 sacctmgr 读取——slurmdbd 权威数据）
# ----------------------------------------------------------------------------
def cmd_slurm_info(username):
    if not name_ok(username):
        die("非法用户名")
    if run(["id", "-u", username]).returncode != 0:
        die("OS 账号 %s 不存在" % username)
    # 该用户的所有关联行（含不同账号）
    raw = sh_out(["sacctmgr", "-n", "-P", "show", "assoc",
                  "user=%s" % username,
                  "format=Account,User,Partition,QOS,Priority,GrpTRES,GrpTRESMins,"
                  "MaxTRES,MaxTRESMins,GrpJobs,GrpSubmit,MaxJobs,MaxSubmit,MaxWall,GrpWall"],
                 timeout=30)
    assocs = []
    qos_names = []
    account_names = []
    for ln in raw.splitlines():
        f = ln.split("|")
        if len(f) < 2 or f[1] != username:
            continue  # 只要该用户行（跳过纯账号/纯 root 的聚合行）
        rec = {
            "account": f[0], "partition": f[2], "qos": f[3],
            "priority": f[4],
            "grp_tres": f[5], "grp_tres_mins": f[6],
            "max_tres": f[7], "max_tres_mins": f[8],
            "grp_jobs": f[9], "grp_submit": f[10],
            "max_jobs": f[11], "max_submit": f[12],
            "max_wall": f[13], "grp_wall": f[14],
        }
        if rec["account"] and rec["account"] not in account_names:
            account_names.append(rec["account"])
        if rec["qos"]:
            for q in rec["qos"].split(","):
                if q and q not in qos_names:
                    qos_names.append(q)
        assocs.append(rec)
    # QoS 定义（优先级 + 限额；新增每用户卡数上限 MaxTRESPU 与 Preempt）
    qos_map = {}
    wanted = list(qos_names)
    for a in account_names:
        q = acct_qos(a)
        if q not in wanted:
            wanted.append(q)
    if wanted:
        fmt = ("Name,Priority,MaxTRES,GrpTRES,MaxTRESMins,GrpTRESMins,"
               "GrpJobs,GrpSubmit,MaxJobs,MaxSubmit,MaxWall,GrpWall,MaxTRESPU,Preempt")
        r2 = run(["sacctmgr", "-n", "-P", "show", "qos", "format=" + fmt],
                 timeout=30)
        if r2.returncode != 0:
            # 老版本 sacctmgr 没有 MaxTRESPU/Preempt 格式字段：退回旧格式，
            # 优先级等旧字段照常给出，每用户卡数上限留空（门户按“未知/不限”显示）
            fmt_old = ("Name,Priority,MaxTRES,GrpTRES,MaxTRESMins,GrpTRESMins,"
                       "GrpJobs,GrpSubmit,MaxJobs,MaxSubmit,MaxWall,GrpWall")
            r2 = run(["sacctmgr", "-n", "-P", "show", "qos",
                      "format=" + fmt_old], timeout=30)
        for ln in (r2.stdout or "").splitlines():
            f = ln.split("|")
            if len(f) < 12 or not f[0].strip() or f[0].strip() not in wanted:
                continue
            pu = f[12].strip() if len(f) > 12 else ""
            preempt = f[13].strip() if len(f) > 13 else ""
            qos_map[f[0].strip()] = {
                "priority": f[1], "max_tres": f[2], "grp_tres": f[3],
                "max_tres_mins": f[4], "grp_tres_mins": f[5],
                "grp_jobs": f[6], "grp_submit": f[7],
                "max_jobs": f[8], "max_submit": f[9],
                "max_wall": f[10], "grp_wall": f[11],
                "max_tres_per_user": pu,
                "per_user_gpu_cap": _gpu_cap_from_tres(pu),
                "preempt": preempt,
            }
    # 该用户的默认账户 + 实际关联账户（多账户展示/申请页用）
    default_account, accounts_info, aerr = _user_accounts_info(username)
    res = {"ok": True, "username": username, "assocs": assocs, "qos": qos_map,
           "default_account": default_account, "accounts": accounts_info}
    if aerr:
        res["accounts_error"] = aerr
    out(res)



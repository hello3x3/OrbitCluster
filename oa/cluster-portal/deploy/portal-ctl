def cmd_get_keys(user):
    """读取某用户 authorized_keys 中的有效公钥行（root 才有权限读 600 文件）。"""
    if not name_ok(user):
        die("非法用户名")
    home = user_home(user)
    ak = os.path.join(home, ".ssh", "authorized_keys")
    keys = []
    if os.path.isfile(ak):
        try:
            with open(ak, "r", encoding="utf-8", errors="replace") as fh:
                for ln in fh:
                    s = ln.strip()
                    if s and PUBKEY_RE.match(s) and s not in keys:
                        keys.append(s)
        except OSError:
            pass
    out({"ok": True, "user": user, "keys": keys})


def cmd_set_keys(user):
    if not name_ok(user):
        die("非法用户名")
    try:
        keys = json.load(sys.stdin)
    except Exception:
        die("stdin 不是合法 JSON")
    if not isinstance(keys, list) or len(keys) > 32:
        die("公钥列表非法（最多 32 条）")
    cleaned = []
    for k in keys:
        if not isinstance(k, str) or not PUBKEY_RE.match(k.strip()):
            die("存在非法公钥格式（仅支持 OpenSSH 格式，一行一条）")
        cleaned.append(k.strip())
    if len(set(cleaned)) != len(cleaned):
        die("存在重复公钥")
    r = run(["id", "-u", user])
    if r.returncode != 0:
        die("OS 账号 %s 不存在" % user)
    uid = r.stdout.strip()
    home = user_home(user)
    sshd = os.path.join(home, ".ssh")
    run(["install", "-d", "-o", user, "-g", user, "-m", "700", sshd], timeout=30)
    ak = os.path.join(sshd, "authorized_keys")
    tmp = ak + ".portal-tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write("\n".join(cleaned) + "\n")
        os.chown(tmp, int(uid), int(uid))
        os.chmod(tmp, 0o600)
        os.replace(tmp, ak)
    except OSError as e:
        die("写入 authorized_keys 失败: %s" % e)
    out({"ok": True, "user": user, "keys": len(cleaned),
         "path": ak})



                die("用法: job-state <用户名> <jobid>")
            cmd_job_state(sys.argv[2], sys.argv[3])
        elif cmd == "log":
            if len(sys.argv) < 4:
                die("用法: log <用户名> <jobid> [行数]")
            cmd_log(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) > 4 else "200")

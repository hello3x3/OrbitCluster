# Slurm 关联 / QoS / 优先级 / 限额（经 sacctmgr 读取——slurmdbd 权威数据）
# ----------------------------------------------------------------------------
def cmd_slurm_info(username):
    if not name_ok(username):
        die("非法用户名")
    if run(["id", "-u", username]).returncode != 0:
        die("OS 账号 %s 不存在" % username)
    # 该用户的所有关联行（含不同账号）
    raw = sh_out(["sacctmgr", "-n", "-P", "show", "assoc",
                  "user=%s" % username,
                  "format=Account,User,Partition,QOS,Priority,GrpTRES,GrpTRESMins,"
                  "MaxTRES,MaxTRESMins,GrpJobs,GrpSubmit,MaxJobs,MaxSubmit,MaxWall,GrpWall"],
                 timeout=30)
    assocs = []
    qos_names = []
    for ln in raw.splitlines():
        f = ln.split("|")
        if len(f) < 2 or f[1] != username:
            continue  # 只要该用户行（跳过纯账号/纯 root 的聚合行）
        rec = {
            "account": f[0], "partition": f[2], "qos": f[3],
            "priority": f[4],
            "grp_tres": f[5], "grp_tres_mins": f[6],
            "max_tres": f[7], "max_tres_mins": f[8],
            "grp_jobs": f[9], "grp_submit": f[10],
            "max_jobs": f[11], "max_submit": f[12],
            "max_wall": f[13], "grp_wall": f[14],
        }
        if rec["qos"]:
            for q in rec["qos"].split(","):
                if q and q not in qos_names:
                    qos_names.append(q)
        assocs.append(rec)
    # QoS 定义（优先级 + 限额）
    qos_map = {}
    if qos_names:
        raw2 = sh_out(["sacctmgr", "-n", "-P", "show", "qos",
                       "format=Name,Priority,MaxTRES,GrpTRES,MaxTRESMins,GrpTRESMins,"
                       "GrpJobs,GrpSubmit,MaxJobs,MaxSubmit,MaxWall,GrpWall"],
                      timeout=30)
        for ln in raw2.splitlines():
            f = ln.split("|")
            if len(f) < 12 or f[0] not in qos_names:
                continue
            qos_map[f[0]] = {
                "priority": f[1], "max_tres": f[2], "grp_tres": f[3],
                "max_tres_mins": f[4], "grp_tres_mins": f[5],
                "grp_jobs": f[6], "grp_submit": f[7],
                "max_jobs": f[8], "max_submit": f[9],
                "max_wall": f[10], "grp_wall": f[11],
            }
    out({"ok": True, "username": username, "assocs": assocs, "qos": qos_map})



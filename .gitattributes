# ============================================================================
# OrbitCluster —— 文本属性
# 目的：跨平台协作时行尾一致；可执行脚本保持 LF 且保留 x 位。
# ============================================================================

# 默认：自动识别文本并统一为仓库内 LF
* text=auto eol=lf

# 源码与文档：显式声明为文本
*.py     text eol=lf
*.sh     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.conf   text eol=lf
*.service text eol=lf

# 无扩展名的可执行脚本，必须保留 LF 与可执行位
oa/cluster-portal/deploy/portal-ctl  text eol=lf
oa/cluster-portal/deploy/install.sh  text eol=lf

# 备份/运维脚本
oa/scripts/*.sh  text eol=lf

# 二进制（不要让 git 尝试做行尾转换）
*.sqsh   binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.gz     binary
*.tgz    binary
*.zip    binary

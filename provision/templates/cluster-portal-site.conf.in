# ============================================================================
# /etc/cluster-portal/site.conf —— 由 provision/render.sh 从 cluster.conf 生成
#   读取方：portalapp/siteconf.py（门户进程）与 deploy/portal-ctl（root 助手）
#   优先级：环境变量 PORTAL_<KEY> > 本文件 > 代码内置默认值
#   本文件**不含密钥**，只描述这套集群的形状。
# ============================================================================

# 节点间 ssh 端口（门户助手据此 ssh/scp 到各计算节点建号、提交、保存镜像）。
# 该端口同时会被自动加入「用户不可申请的保留端口」列表。
SSH_PORT=@@SSH_PORT@@

# gres 型号 token -> 界面展示名（纯数字 token 本来就会自动补 "RTX " 前缀，
# 这里显式写出只为可读性与将来改名方便）。
GPU_MODEL_MAP=@@GPU_MAP@@

# 集群信息不可用（slurmctld 未起/查询失败）时的兜底 GPU 型号。
DEFAULT_GPU_MODEL=@@DEFAULT_GPU_MODEL@@

# Slurm 会计账户名（sacctmgr account）。用户必须在这个账户下有关联，
# 否则在 AccountingStorageEnforce=associations 的集群上 sbatch 会被拒。
# 与 base-cluster/scripts/cluster-admin/add-user.sh 的 CLUSTER_ACCOUNT 保持一致。
ACCOUNT=@@ACCOUNT@@

# 首次建库时的套餐种子。
SEED_PLANS=/etc/cluster-portal/plans.json
